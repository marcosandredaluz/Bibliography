# ==============================================================================
# Bibliografia Forense - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e customize conforme seu ambiente local
# ==============================================================================

# Configurações do Servidor Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=23119
DEBUG=false

# Banco de Dados SQLite Local
DATABASE_PATH=data/bibliografia_local.db

# Timeouts e Endpoints Externos de Coleta
CROSSREF_TIMEOUT_SECONDS=8
SCIELO_API_URL=http://articlemeta.scielo.org/api/v1/article/
BVS_SEARCH_URL=https://pesquisa.bvsalud.org/portal/

# Chaves de API Opcionais (Aceleração de cota de bases acadêmicas)
# SEMANTIC_SCHOLAR_API_KEY=sua_chave_aqui
# PUBMED_API_KEY=sua_chave_ncbi_aqui

# Modelos de Embeddings Vetoriais
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Privacidade e Rotação de Logs
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/bibliografia_app.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_ANONYMIZE_MANUSCRIPTS=true
