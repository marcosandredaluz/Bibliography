{
  "name": "bibliography",
  "productName": "Bibliography",
  "version": "1.0.1",
  "description": "Open-source academic writing assistant, federated literature search, PRISMA 2020 systematic review screening, and forensic citation verification engine",
  "author": "Marcos André da Luz <https://www.linkedin.com/in/marcos-andre-da-luz-847039141>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/marcosandredaluz/Bibliography#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosandredaluz/Bibliography.git"
  },
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test:calibracao": "node test-calibracao-massiva.mjs && node test-redteam-bateria-03.mjs && node test-licao-01.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@huggingface/transformers": "^4.3.2",
    "citeproc": "^2.4.63",
    "diff-match-patch": "^1.0.5",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "br.marcos.bibliografia",
    "productName": "Bibliografia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bibliografia"
    }
  }
}
