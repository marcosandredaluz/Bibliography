amily": "Herrmann", "given": "Gisela"}], "publisher": "Meyer OHG mbH", "publisher-place": "Gütersloh"}, {"id": "extra1", "type": "article-journal", "title": "Hinter rennen erst Maus beim Wohnung nur nein", "language": "de_DE", "issued": {"date-parts": [[1997]]}, "author": [{"family": "Noack", "given": "Sabri", "non-dropping-particle": "da"}, {"family": "Neuschäfer", "given": "Dragan"}, {"family": "Mälzer", "given": "Amir"}, {"family": "Wilms", "given": "Corinne"}], "container-title": "BMC Public Health", "volume": "34", "issue": "6", "page": "877-886", "DOI": "10.99999/teste.treino.94329"}], "paragrafos": [[{"texto": "Wenig Herz gab Nacht rufen wissen wünschen. Tragen Schluss hinter Onkel.", "citacao": {"itens": [{"id": "it005"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Über leben Woche neu.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Sache heißen Rad nah tun jetzt genau. Uhr Auto zeigen Zimmer. Land kaufen Hase ging rufen halten.", "citacao": null}, {"texto": "Glas wirklich singen Himmel. Glücklich schön Tür jung lange.", "citacao": {"itens": [{"id": "it012"}, {"id": "it015"}, {"id": "it002"}], "narrativa": false}}, {"texto": "Wohl hängen Vogel gleich laufen lange Apfel.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Baum ließ fiel blau.", "citacao": {"itens": [{"id": "it005"}], "narrativa": true}}, {"texto": "Nun ins anfangen lustig. Ließ Eis schlafen drei.", "citacao": {"itens": [{"id": "it018"}, {"id": "it003"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Finger weinen suchen frei geben. Wiese Lehrerin dort Wasser Affe fiel daran. Seite krank neben über Luft.", "citacao": {"itens": [{"id": "it004"}], "narrativa": true}}], [{"texto": "Glas lachen Zeit.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Glauben nein unter Flasche möglich denken sicher. Schicken Freund traurig selbst Eltern tragen.", "citacao": {"itens": [{"id": "it014"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Bild Vater spät neben bringen.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Warum erschrecken nach alt alle Platz Fußball. Rund vor lachen schlimm rot.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Einige für Tier am.", "citacao": {"itens": [{"id": "it001"}, {"id": "it014"}], "narrativa": false}}, {"texto": "Zahl Lehrerin überall zurück Tisch gegen und. Wohl fast ließ davon Schule.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Dauern hängen alle offen von Maus. Damit See Mensch erschrecken hören.", "citacao": null}, {"texto": "Es schwer Haus bin vorbei Straße.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Maus wenig ganz Affe. Freuen ihr laut ihr wieder fangen darin. Zurück Wissen gern zehn Kopf Onkel.", "citacao": {"itens": [{"id": "it021"}], "narrativa": true}}], [{"texto": "Lernen weinen wahr weit rot Zahl letzte. Bei gleich verkaufen Haus Schluss stark.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Besser Papa mit sagen oder daran. Endlich Meer seit vor.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Wo warm heiß rot weiter geben Haus glücklich.", "citacao": null}], [{"texto": "Wissen kann arbeiten packen gelb Zeitung Affe weil.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Mama nach Onkel leicht. Halbe und beim mit gar. Sagen Herr kam früh Tür. Gern Musik gestern heute.", "citacao": {"itens": [{"id": "it003"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Glas dürfen Bein besser da.", "citacao": {"itens": [{"id": "it010"}], "narrativa": true}}], [{"texto": "Dumm darin Lehrer holen. Tisch Zimmer Affe seit.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Zwischen Haare bauen braun.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Sommer sieht Katze etwas man Mensch.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Blau wie lachen nein zusammen Nase merken sieben.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}, {"texto": "Dauern Familie neun davon.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Zwei halten dir sich.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}, {"texto": "Wollen oder Stück Affe.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Unten nimmt dazu fiel Mensch weg fest früh. Lachen verlieren fast erst kochen weiß. Wissen Ende See den.", "citacao": null}, {"texto": "Schicken Spaß arbeiten unter Bein nah erklären. Hören hoch sollen Eis machen. Ins nur alt schlagen.", "citacao": {"itens": [{"id": "it019"}, {"id": "it004"}, {"id": "it005"}], "narrativa": false}}], [{"texto": "Leute erklären Küche singen verkaufen Meer.", "citacao": null}], [{"texto": "Bett oft Flasche Oma. Vier den aus der was. Früh kein Onkel dort schwimmen am bis gegen.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Rund sicher Bruder tun.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Glas auf bald bleiben sehen Angst.", "citacao": {"itens": [{"id": "it016"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Hase Zeit las letzte Zimmer.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Selbst Buch Boden nehmen.", "citacao": {"itens": [{"id": "it021"}], "narrativa": true}}, {"texto": "Schuh endlich um warum klein zum.", "citacao": null}]], "direta": {"texto": "Monat schwimmen fährt weinen endlich dein suchen lernen kommen", "citacao": {"itens": [{"id": "it010", "locator": "263", "label": "page"}], "narrativa": false}}, "tabela": [["Fressen", "Berg Fußball war.", {"itens": [{"id": "it023"}], "narrativa": false}], ["Plötzlich", "Katze nehmen viel Stadt uns nichts darin alt.", {"itens": [{"id": "it003"}], "narrativa": false}], ["Schon", "Wieder schenken bekommen üb