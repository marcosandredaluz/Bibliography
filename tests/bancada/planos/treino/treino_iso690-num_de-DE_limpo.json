ids", "given": "Constanze"}], "publisher": "Jungfer", "publisher-place": "Wesel"}, {"id": "it031", "type": "report", "title": "Straße las verstecken stark dunkel suchen Geburtstag Schiff langsam tot Freund", "language": "de_DE", "author": [{"literal": "Instituto Nacional de Câncer (Brasil)"}], "publisher": "Lorch Bolander e.V.", "publisher-place": "Berlin"}, {"id": "it032", "type": "article-journal", "title": "Leute denn einige", "language": "de_DE", "issued": {"date-parts": [[2005]]}, "author": [{"family": "Radisch", "given": "Dennis"}, {"family": "Wilms", "given": "Siegbert"}, {"family": "Rose", "given": "Wilfriede"}, {"family": "Plath", "given": "Maya"}, {"family": "Kreusel", "given": "Malgorzata"}, {"family": "Mülichen", "given": "Hedy"}], "container-title": "Medical Mycology", "volume": "54", "issue": "6", "page": "212-225", "DOI": "10.99999/teste.treino.92741"}, {"id": "it033", "type": "chapter", "title": "Gesund wirklich sollen sagen weiß am gibt geben sie fliegen tief ohne", "language": "de_DE", "issued": {"date-parts": [[2005]]}, "author": [{"family": "Radisch", "given": "Dennis"}, {"family": "Wilms", "given": "Siegbert"}, {"family": "Rose", "given": "Wilfriede"}, {"family": "Plath", "given": "Maya"}, {"family": "Kreusel", "given": "Malgorzata"}, {"family": "Mülichen", "given": "Hedy"}], "container-title": "Bauer genau las für immer frei Baum", "publisher": "Süßebier AG & Co. OHG", "publisher-place": "Jena", "editor": [{"family": "Sorgatz", "given": "Ingelore"}], "page": "251-266"}], "paragrafos": [[{"texto": "Boden sonst Eltern sonst Sohn suchen Schule.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Spiel Spaß von. Her sein Hand spielen lustig wie Fenster.", "citacao": null}, {"texto": "Aus Spaß fröhlich helfen schlafen sicher. Voll dich gerade bringen.", "citacao": null}], [{"texto": "Durch jetzt hin.", "citacao": {"itens": [{"id": "it009"}], "narrativa": true}}, {"texto": "Fiel warm ich leicht. Tag suchen nein Mutter machen wir antworten. Zehn vor geben ihn Geld sind hören.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Dafür so beißen wirklich glauben.", "citacao": {"itens": [{"id": "it004"}, {"id": "it018"}, {"id": "it033"}], "narrativa": false}}], [{"texto": "Schlecht lustig Wort was gerade.", "citacao": null}, {"texto": "Unter Schüler Apfel vielleicht nun wie.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Arzt hinter nein bin Affe. Herz Monate fehlen Sonne. Kind gefährlich Pferd gleich.", "citacao": {"itens": [{"id": "it013"}], "narrativa": true}}, {"texto": "Leute lieb Wohnung gehören. Zu alt ihm zurück Jahr schlagen versuchen.", "citacao": null}, {"texto": "Fisch mit Fuß war.", "citacao": {"itens": [{"id": "it003"}, {"id": "it031"}], "narrativa": false}}], [{"texto": "Stück dazu dem rennen laut hoch also.", "citacao": {"itens": [{"id": "it013"}], "narrativa": true}}], [{"texto": "Ball laut oben Arzt ist setzen Licht. Fahren Zahl acht packen nehmen daran Klasse.", "citacao": {"itens": [{"id": "it010"}], "narrativa": true}}, {"texto": "Viel einige Nase Auto wir Mensch.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Acht schwarz fliegen. Zusammen vier reiten leise denken unten. Her gar mit fröhlich Klasse Herz.", "citacao": null}, {"texto": "Öffnen Haus Schnee mal singen.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}], [{"texto": "Nun Meer Wasser Name.", "citacao": {"itens": [{"id": "it028"}], "narrativa": true}}, {"texto": "Fliegen Zimmer doch zur Schluss Uhr machen.", "citacao": null}], [{"texto": "Auto wichtig wir Hand viel.", "citacao": {"itens": [{"id": "it008"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Fahren werfen Ball Monate jeder Schiff.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Voll denken bin freuen grün. Affe nächste Monat dick finden Polizei einige schon. Fenster schwimmen Fußball Mensch grün lange Familie Maus. Freuen Fußball anfangen Bild schön einfach Brot reich.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Essen Mensch nun.", "citacao": null}, {"texto": "Ihr oft schon zwei.", "citacao": {"itens": [{"id": "it006"}, {"id": "it019"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Schon wieder so Fußball lange der ohne Buch.", "citacao": {"itens": [{"id": "it023"}, {"id": "it002"}, {"id": "it024"}], "narrativa": false}}], [{"texto": "Holen warten müde Ding kommen.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Lassen zurück sein. Singen hinein kaufen oben. Andere Opa sonst groß.", "citacao": {"itens": [{"id": "it021"}], "narrativa": true}}], [{"texto": "Wieder Monate richtig bekommen hinein möglich.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Hat Boden Ding jeder reiten. Beißen Platz dein Vater nicht Brief.", "citacao": {"itens": [{"id": "it002"}], "narrativa": true}}, {"texto": "Singen wieder Hase glücklich endlich. Führen glauben dürfen werden fiel halbe schnell liegen. Mama schon mögen Wagen immer grün tief.", "citacao": {"itens": [{"id": "it013"}], "narrativa": true}}, {"texto": "Beim voll Tisch führen.", "citacao": {"itens": [{"id": "it009"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Gab doch Sonne beide Nacht zurück Monat.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Auge gehören fliegen zwischen offen.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Ziehen doch zehn Wetter. Ihn sehr Himmel er legen beißen. Bauen hinter heraus müde etwas verlieren setzen will.", "citacao": {"itens": [{"id": "it026"}, {"id": "it030"}], "narrativa": false}}, {"texto": "Brief Monat laut sie gelb dein.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Erde lieb schlagen Weihnachten. Eis ein draußen müssen Essen.", "citacao": {"itens": [{"id": "it009"}, {"id": "it017"}], "narrativa": false}}], [{"texto": "Eigentlich nicht dort vielleicht bei.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}, {"texto": "Rechnen hoch Hand verkaufen an jeder wirklich zusammen. Da spielen früh Wissen beim sehr.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Und etwas reich ich draußen beim. Vorbei rechnen fährt Kind einfach beißen Lehrerin treffen.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}, {"texto": "Zeit neben schreien Familie Flasche verlieren Winter.", "citacao": {"itens": [{"id": "it032"}], "narrativa": false}}], [{"texto": "Buch Ende ihn aus hoch Boden. Antworten nur oder Brief da war Gesicht.", "citacao": {"itens": [{"id": "it004"}, {"id": "it017"}], "narrativa": false}}, {"texto": "Hilfe nah Bein endlich da.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Zeigen Bruder neben Feuer Freude tot Meer.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}], [{"texto": "Baum neun mein Uhr Winter. Stelle werfen Monate.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}, {"texto": "Himmel der sind.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}], [{"texto": "Gehören Eis alt ziehen ohne hart Wald. Dauern versuchen böse. Weg unter Sonne vier weil rot.", "citacao": {"itens": [{"id": "it029"}], "narrativa": false}}, {"texto": "Fröhlich Blume lachen lieb.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}, {"texto": "Mit Schule schicken nah da. Mutter los gehen frei wer langsam Ding.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Kein zehn Loch einigen Schnee bekommen gelb.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}]], "direta": {"texto": "Sich kaufen dann holen Rad Auto Brot um erschrecken", "citacao": {"itens": [{"id": "it021", "locator": "32", "label": "page"}], "narrativa": false}}, "tabela": [["Offen", "Spielen bauen nah dick ein.", {"itens": [{"id": "it015"}], "narrativa": false}], ["Spielen", "Ab Uhr weinen wissen liegen.", {"itens": [{"id": "it019"}], "narrativa": false}], ["See", "Verlieren Küche sein gelb.", {"itens": [{"id": "it033"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it030"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}