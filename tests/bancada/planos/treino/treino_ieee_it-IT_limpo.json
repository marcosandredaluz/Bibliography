.99999/teste.treino.12736"}], "paragrafos": [[{"texto": "Minuto completamente godere risultare affermare. Stasera centrale semplice pieno.", "citacao": {"itens": [{"id": "it018"}, {"id": "it014"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Letto facile necessità sorridere chissà parte eccetera. Cambiare straordinario malattia strano mano.", "citacao": {"itens": [{"id": "it008"}], "narrativa": true}}, {"texto": "Poesia chi caro triste eccetera assistere tempo ognuno.", "citacao": null}], [{"texto": "Buio nulla distanza figura su no corsa.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}, {"texto": "Insistere contenere militare casa. Centrale frutto festa.", "citacao": {"itens": [{"id": "it022"}, {"id": "it026"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Udire caratteristico solito risolvere mangiare lo costa esistere. Alzare campo presentare montagna maggio.", "citacao": {"itens": [{"id": "it018"}, {"id": "it002"}], "narrativa": false}}, {"texto": "Foglia eccetera chissà male bambino cane cucina.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Mestiere successo bisognare casa fermo.", "citacao": {"itens": [{"id": "it011"}, {"id": "it027"}], "narrativa": false}}, {"texto": "Grazia comune comprare qui.", "citacao": {"itens": [{"id": "it015"}], "narrativa": true}}], [{"texto": "Problema estero aspettare reale arte discutere.", "citacao": null}, {"texto": "Testa professore vostro privato mezzo. Fame principio medico notare ottenere.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Rivolgere sorridere sole parecchio.", "citacao": {"itens": [{"id": "it016"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Stasera parecchio metro esempio congresso.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Niente bastare dirigere.", "citacao": {"itens": [{"id": "it021"}], "narrativa": true}}, {"texto": "Costruzione bagno peso spirito scusare. Bestia spesa stare dietro. Almeno foglia ritenere sorridere volgere.", "citacao": null}, {"texto": "Lettera generale programma ora frutto bene porre.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Muovere regno domani staccare arma.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}], [{"texto": "Passione maggiore albergo tono teatro.", "citacao": {"itens": [{"id": "it020"}, {"id": "it009"}], "narrativa": false}}], [{"texto": "Prova opera fiume superiore ottenere esso.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Successo dolore collina capace albero. Bocca errore segretario bisognare diretto pane.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Notte vecchio fuoco processo nuovo.", "citacao": {"itens": [{"id": "it011"}, {"id": "it004"}], "narrativa": false}}], [{"texto": "Dove comporre segretario.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Annunciare prendere fianco.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Sistema con e completamente adesso dare. Opporre discorso paese qualche. Argomento sede aprire zitto.", "citacao": {"itens": [{"id": "it019"}, {"id": "it010"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Nulla azione uso lotta errore durante. Sorridere giorno zitto.", "citacao": {"itens": [{"id": "it000"}], "narrativa": true}}], [{"texto": "Giocare articolo zio lavorare estendere risposta.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Attento preoccupare sacro discorso resistere.", "citacao": {"itens": [{"id": "it001"}, {"id": "it019"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Gente contadino conoscere.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Proprio fermare giù aggiungere difficile vostro.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Non ferro rapido proporre.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Affrontare isola riunire attento camminare passo stanco segreto.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Chiedere istante addirittura conto volare villa pubblicare.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Guerra neanche mattino libro giù.", "citacao": {"itens": [{"id": "it001"}, {"id": "it003"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Come padrone ritorno diretto chiamare.", "citacao": {"itens": [{"id": "it009"}], "narrativa": true}}]], "direta": {"texto": "Attento cavallo abbastanza accompagnare presto giudizio porto costituire periodo musica fame carattere", "citacao": {"itens": [{"id": "it009", "locator": "155", "label": "page"}], "narrativa": false}}, "tabela": [["Vasto", "Insomma aiuto pelle uguale frutto chiesa.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Libero", "Tipo tanto piano ah bambina opera tutto.", {"itens": [{"id": "it014"}], "narrativa": false}], ["Colpo", "Lanciare pezzo vento morale estendere.", {"itens": [{"id": "it010"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it017"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}