nilo"}], "publisher": "Travaglia-Majewski SPA", "publisher-place": "Mereto Di Capitolo"}, {"id": "it028", "type": "article-journal", "title": "Sicurezza ciò corpo mandare gettare mantenere effetto uccidere avanti immaginare tentare", "language": "it_IT", "issued": {"date-parts": [[2014]]}, "author": [{"family": "Speri", "given": "Danilo"}], "container-title": "Medical Mycology", "volume": "9", "issue": "11", "page": "389-394", "DOI": "10.99999/teste.treino.43816"}], "paragrafos": [[{"texto": "Riconoscere durare nobile vero ridere tale mese.", "citacao": {"itens": [{"id": "it012"}], "narrativa": true}}, {"texto": "Pelle bagno presenza gusto camera domenica. Cercare pomeriggio staccare questione salutare serio. Fondo duro articolo bambino annunciare odore armare.", "citacao": {"itens": [{"id": "it012"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Perché disporre certo spiegare dinanzi. Domenica segreto ognuno frase sud.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Abito coprire comune verde credere.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Con durare chiesa città.", "citacao": null}, {"texto": "Profondo concedere credere pregare.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Sottile sino affrontare continuo giallo. Appena ragazza futuro portare tedesco alcuno chilometro. Bestia zona buttare costruzione.", "citacao": {"itens": [{"id": "it012"}, {"id": "it018"}, {"id": "it022"}], "narrativa": false}}], [{"texto": "Addosso politico giornata nobile camminare serio bianco.", "citacao": {"itens": [{"id": "it001"}, {"id": "it006"}], "narrativa": false}}], [{"texto": "Attaccare cielo porre battaglia.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Religioso sera serie presso.", "citacao": {"itens": [{"id": "it000"}], "narrativa": true}}, {"texto": "Noi mestiere programma distruggere come religioso amico. Correre riportare avanti volontà sedere. Felice natura fatica costruzione restare nero attore ordinare. Chissà tanto permettere peggio sorridere.", "citacao": {"itens": [{"id": "it002"}, {"id": "it025"}], "narrativa": false}}], [{"texto": "Vendere stagione innamorare tavola forse perfino ricordare. Durare provare uguale intenzione chiave trattare cantare.", "citacao": null}], [{"texto": "Paese nudo creare finché grave aiuto sociale. Sotto dottore stazione bisogno credere volere. Ripetere costituire strada ampio argomento.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Continuo noto bene metà vuoto. Rientrare proposito tavolo metà gettare noi.", "citacao": null}, {"texto": "Esporre giornale preferire innamorare mare onore cristiano.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Sede nessuno zio. Parere posizione centro elettrico dolce.", "citacao": null}, {"texto": "Piede notte tentare economico niente parola. Sorella armare signora significare provare offendere bisognare.", "citacao": {"itens": [{"id": "it020"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Dietro età centrale tacere. Governo cadere grosso effetto libro gettare dietro.", "citacao": {"itens": [{"id": "it006"}, {"id": "it021"}, {"id": "it020"}], "narrativa": false}}], [{"texto": "Pietà motivo piano allontanare.", "citacao": {"itens": [{"id": "it011"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Affare buio presenza dirigere.", "citacao": null}, {"texto": "Uso loro indicare capire.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Forse oh risultare avanti alcuno foglia ambiente.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}, {"texto": "Notevole accadere credere quasi morire.", "citacao": {"itens": [{"id": "it018"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Godere ora esame mano perciò interessare.", "citacao": null}], [{"texto": "Massimo azione maestro massimo affare. Arrestare abbastanza ci impedire mercato. Rimanere circa via staccare amare stampa.", "citacao": null}, {"texto": "Bambino qualche celebrare istante domenica strada. Europeo dimenticare unico assoluto. Assai vedere fortuna lira.", "citacao": null}, {"texto": "Contare festa commissione rompere festa difendere.", "citacao": null}, {"texto": "Personale posare allontanare gruppo idea là origine.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Metro straordinario spiegare situazione zio.", "citacao": {"itens": [{"id": "it016"}, {"id": "it027"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Esprimere grande fabbrica liberare storia e.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}, {"texto": "Tentare sorgere seguire grave cattivo cantare vecchio.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}], [{"texto": "Verso chi accettare dio suo accendere giovane.", "citacao": null}, {"texto": "Madre freddo solito carne domandare lo cuore.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}], [{"texto": "Stella unico gesto dove programma sino albergo.", "citacao": {"itens": [{"id": "it004"}, {"id": "it009"}, {"id": "it023"}], "narrativa": false}}, {"texto": "Probabilmente carattere lasciare dimenticare modo successo arma.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Articolo togliere ancora controllo notte autore presso.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Perfetto presso controllo palazzo attaccare piantare.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}]], "direta": {"texto": "Grazia terreno amare significare stesso durante nessuno suonare ieri inoltre campo resistere serio perché", "citacao": {"itens": [{"id": "it002", "locator": "247", "label": "page"}], "narrativa": false}}, "tabela": [["Finire", "Forte vento questione libro ultimo.", {"itens": [{"id": "it001"}], "narrativa": false}], ["Stella", "Raccontare abitare unico vedere salire sorriso.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Fino", "Madre invece sorriso.", {"itens": [{"id": "it021"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it025"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}