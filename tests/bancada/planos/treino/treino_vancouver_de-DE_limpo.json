n"}], "container-title": "Revista de Saúde Pública", "volume": "16", "issue": "1", "page": "499-511", "DOI": "10.99999/teste.treino.59426"}, {"id": "it032", "type": "article-journal", "title": "Tun draußen gestern Bein beim mal so Tante gar er vier", "language": "de_DE", "issued": {"date-parts": [[2021]]}, "author": [{"family": "Heinz", "given": "Ayten"}], "container-title": "Das Gesundheitswesen", "volume": "35", "issue": "9", "page": "682-686", "DOI": "10.99999/teste.treino.36362"}, {"id": "it033", "type": "article-journal", "title": "Zahl Glas Tisch letzte Pferd Berg rot nächste warum nennen bringen zwei lieb", "language": "de_DE", "issued": {"date-parts": [[2021]]}, "author": [{"family": "Heinz", "given": "Ayten"}], "container-title": "Medical Mycology", "volume": "36", "issue": "2", "page": "180-192"}], "paragrafos": [[{"texto": "Dem finden Glas gern.", "citacao": {"itens": [{"id": "it007"}], "narrativa": true}}, {"texto": "Jung lieb Fisch singen Fuß Schuh. In Freude Stück singen.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Sagen wie Luft Wagen Milch ihm Katze.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}, {"texto": "Liegen Mensch das schicken werden schlimm ruhig Winter.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}], [{"texto": "Kein suchen gern ob Opa Bruder.", "citacao": {"itens": [{"id": "it025"}, {"id": "it001"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Bekommen Welt jung. See heraus Berg vom Buch los den. Ab voll sechs stellen beide. Sohn wollen Brot Wasser die auf beim.", "citacao": null}, {"texto": "Zimmer verstecken Hilfe warm weit. Erst Lehrerin Beispiel.", "citacao": {"itens": [{"id": "it026"}, {"id": "it010"}, {"id": "it033"}], "narrativa": false}}], [{"texto": "Davon über rund nennen Tisch. Stück dann fröhlich viel Luft dick Apfel. Halten unter Tag wird ging sehr Bein.", "citacao": null}], [{"texto": "Immer zusammen Arzt.", "citacao": {"itens": [{"id": "it000"}, {"id": "it031"}], "narrativa": false}}], [{"texto": "Steigen ihm aber gerade.", "citacao": null}, {"texto": "Geben Luft zu will bringen.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}, {"texto": "Geburtstag sprechen gern gleich warten.", "citacao": null}], [{"texto": "Hoch gerade zu geben.", "citacao": null}, {"texto": "Sein Mädchen wer Sonntag davon tun kalt. Vater Haus Abend.", "citacao": {"itens": [{"id": "it005"}, {"id": "it030"}], "narrativa": false}}, {"texto": "Kam mögen den heiß nennen gehen früh wieder.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Sonne Spiel bei Mutter.", "citacao": {"itens": [{"id": "it004"}, {"id": "it026"}], "narrativa": false}}, {"texto": "Darauf gelb Wort Wald erzählen was deshalb Haus.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}, {"texto": "Unten unten Musik rennen also krank.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}], [{"texto": "Hinter weiter halbe ein krank Brief Hase.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Da führen an wahr was Bild mein. Lieb Blume Loch schön.", "citacao": {"itens": [{"id": "it027"}], "narrativa": true}}], [{"texto": "Vielleicht einmal sechs singen fehlen.", "citacao": {"itens": [{"id": "it014"}, {"id": "it028"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Sein Straße sich jung Herr wissen Küche.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Las die traurig hoch Geschichte.", "citacao": {"itens": [{"id": "it028"}, {"id": "it018"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Meer holen bald. Früher das Wohnung unten Fisch Fußball. Stelle leicht zwei weit bauen ab darin arbeiten.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "An Wort dem hat.", "citacao": {"itens": [{"id": "it025"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Zwischen heiß bis wenig.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Weiter Junge sechs Nase über schauen sprechen.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Loch fährt glücklich Wort Schiff um. Los fallen immer letzte zu fröhlich hoch. Essen Polizei tun erklären Garten immer. Eigentlich Winter Geschenk.", "citacao": null}], [{"texto": "Wissen dick weiß. Schreiben weiß sieht selbst Onkel.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Alle Wetter Sonne fangen.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Ding sein drei finden Kopf dauern darin früh.", "citacao": {"itens": [{"id": "it029"}], "narrativa": false}}], [{"texto": "Hängen gefährlich seit schon Dorf nehmen dir Gesicht.", "citacao": {"itens": [{"id": "it020"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Hilfe spät Schüler groß Katze wirklich. Erschrecken geben schnell Fußball dumm auch früh.", "citacao": null}, {"texto": "Heiß turnen vier den tragen.", "citacao": {"itens": [{"id": "it032"}], "narrativa": false}}], [{"texto": "Schule lange spät ich in Straße erklären. Lernen Wort von. Fenster beide grün da.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}], [{"texto": "Endlich was schlagen Sonne jeder nimmt. Ferien turnen nah einfach. Fehlen kennen Zug wirklich lernen.", "citacao": {"itens": [{"id": "it012"}], "narrativa": true}}], [{"texto": "Lange Schuh stehen warum sicher.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}], [{"texto": "Eltern wichtig Geschichte mögen. Zurück als Hilfe nämlich fröhlich halbe. Als sieben schicken.", "citacao": {"itens": [{"id": "it018"}, {"id": "it016"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Selbst trinken nah nennen haben gestern Fisch.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Seit schenken hinter ist. Sehr gehen hängen um hinter fliegen legen Auto.", "citacao": {"itens": [{"id": "it016"}], "narrativa": true}}, {"texto": "Brief leicht Seite Garten Bauer steigen.", "citacao": null}], [{"texto": "Zeitung Teller hoch aber.", "citacao": {"itens": [{"id": "it017"}], "narrativa": true}}, {"texto": "Dann schlagen dich fallen. Lustig Mama nämlich ging gegen Bruder dafür.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}], [{"texto": "Kopf Angst sagen lachen.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Ding sehr verstecken Brief war.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}, {"texto": "Braun Platz ihr Spiel schenken Bild.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Spaß heraus kaufen Mama Mädchen Brot.", "citacao": null}, {"texto": "Fünf fünf Auge bis Affe gab.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}]], "direta": {"texto": "Steigen Luft wir finden Mama essen verlieren schön dumm Wiese wirklich sich arbeiten", "citacao": {"itens": [{"id": "it015", "locator": "56", "label": "page"}], "narrativa": false}}, "tabela": [["Fallen", "Hase man rennen und.", {"itens": [{"id": "it027"}], "narrativa": false}], ["Blume", "Ließ hier Sommer sollen gar nehmen.", {"itens": [{"id": "it010"}], "narrativa": false}], ["Sollen", "Schwer denn heißen Polizei und scheinen Leute.", {"itens": [{"id": "it021"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it018"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}