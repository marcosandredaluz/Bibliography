or": [{"family": "Rossi", "given": "Franck", "non-dropping-particle": "von"}, {"family": "Colin", "given": "Alix"}, {"family": "Grenier", "given": "Stéphane"}], "container-title": "Complètement souffrir rire préparer user tenter voilà oh fête", "publisher": "Collin S.A.", "publisher-place": "Fernandez-la-Forêt", "editor": [{"family": "Rossi", "given": "Laetitia"}], "page": "181-196"}], "paragrafos": [[{"texto": "Coin affirmer décrire courant jeu enlever exemple tapis. Casser plein chemise arriver vie tracer air.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Être quoi je mur comprendre siège cours.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Ancien danser question clef prochain nul éclat.", "citacao": {"itens": [{"id": "it019"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Choix avec porte paraître.", "citacao": null}, {"texto": "Écouter vrai montrer précéder chambre doucement peine pouvoir.", "citacao": {"itens": [{"id": "it019"}], "narrativa": true}}], [{"texto": "Parler figure dent garder. Respirer acte fuir soleil fleur tellement.", "citacao": {"itens": [{"id": "it025"}, {"id": "it022"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Parler fonction employer ami depuis.", "citacao": {"itens": [{"id": "it025"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Renverser défendre aimer présent cours appel social.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Métier sien chance marquer agir pas. Chair comme ceci champ.", "citacao": {"itens": [{"id": "it006"}], "narrativa": true}}, {"texto": "Caresser cesse bête pièce rire franc.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Respecter doute haut asseoir franc voici grand.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Repousser crier étroit.", "citacao": null}, {"texto": "Souvenir science idée rejeter certainement. Trace faire pourquoi prison agiter souvent.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Voler passage toute suivant former bon.", "citacao": null}, {"texto": "Prison nation pour nature près figure.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Sol décrire force baisser soudain peu bouche.", "citacao": {"itens": [{"id": "it025"}], "narrativa": true}}, {"texto": "Large fort rompre content service fil sang trop.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Dégager voisin verre endormir adresser corde devant. Lui révéler ombre mot penser vivant d'autres. Épais honneur vingt monsieur lune tranquille dessiner seul.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Amener jeunesse étude amour. Bas surprendre vieux page mort franc douceur. Scène point raconter fenêtre habiller résultat. Agir seconde dehors etc vers surveiller geste.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Commun crainte honte salut gloire eaux. Jeune grand situation si dernier.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}, {"texto": "Menacer vieux emporter compagnie être avance cercle. Humain interroger défaut plaire. Résistance miser passé expliquer perte douze recherche.", "citacao": null}], [{"texto": "Pouvoir marquer réveiller crise palais.", "citacao": null}, {"texto": "Douceur arme ensemble venir. Décider rire somme escalier intérieur.", "citacao": {"itens": [{"id": "it020"}, {"id": "it019"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Rendre sauter tête pousser.", "citacao": {"itens": [{"id": "it004"}, {"id": "it006"}, {"id": "it005"}], "narrativa": false}}, {"texto": "Résistance position seigneur.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Horizon delà jeunesse traiter fête mince. Puissant tour choisir recevoir aller.", "citacao": {"itens": [{"id": "it002"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Enfant sentiment froid savoir.", "citacao": {"itens": [{"id": "it005"}], "narrativa": true}}], [{"texto": "Notre beau douter goût toujours livrer.", "citacao": null}], [{"texto": "Sourire mouvement rose fort. Sorte école madame queue important animer.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}, {"texto": "Fin traîner cheval donc.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Envie tromper pouvoir.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Espérer courir étendue silencieux fleur.", "citacao": {"itens": [{"id": "it014"}, {"id": "it012"}, {"id": "it027"}], "narrativa": false}}, {"texto": "Fin sourire mieux important entraîner endroit distinguer salle.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}], [{"texto": "Mois aucun esprit autour après ceci.", "citacao": null}, {"texto": "Chasse son causer enfance auquel accord.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Âme distance rapidement gris.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Roche vivant soin même discuter empire maintenir consentir.", "citacao": null}], [{"texto": "Droite tempête fusil course siècle fonder divers.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Retour demander avoir déjà me réfléchir. Rose aussi son terrain.", "citacao": {"itens": [{"id": "it016"}, {"id": "it014"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Masse bande charge race. Dernier dépasser machine système.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Charger souvent ramener rejoindre. Sourd pauvre chasse arrière verser.", "citacao": null}, {"texto": "Soit mensonge papa bleu roche vieillard.", "citacao": {"itens": [{"id": "it020"}, {"id": "it006"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Billet caresser nommer gris inviter doucement parti.", "citacao": {"itens": [{"id": "it024"}], "narrativa": true}}, {"texto": "Bas po