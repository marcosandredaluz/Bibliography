e": "3", "issue": "1", "page": "378-382"}, {"id": "extra1", "type": "webpage", "title": "Soutenir crier précieux dominer rassurer rappeler", "language": "fr_FR", "issued": {"date-parts": [[2009]]}, "author": [{"family": "Reynaud", "given": "Suzanne", "non-dropping-particle": "von"}, {"family": "Brunet", "given": "Thibault"}, {"family": "Jacquot", "given": "Camille"}], "URL": "https://exemplo-treino.org/3890", "accessed": {"date-parts": [[2026, 11, 10]]}}], "paragrafos": [[{"texto": "Du droite lieu désirer inutile.", "citacao": {"itens": [{"id": "it029"}], "narrativa": true}}, {"texto": "Trait éprouver repas. Épais puissant indiquer question nerveux.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Conscience plaire mourir cri prouver qualité.", "citacao": {"itens": [{"id": "it000"}, {"id": "it008"}], "narrativa": false}}], [{"texto": "Pour accorder verre autour marché étendue lettre.", "citacao": {"itens": [{"id": "it006"}, {"id": "it023"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Qui chaud servir fond.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "L'Une disposer détruire intention oeuvre.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "User déchirer inspirer aventure demande contre casser.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}, {"texto": "Revoir depuis valeur.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Jambe combat soin. Recevoir dresser reconnaître prêter âme million résister front. Retenir quant à chat question noir.", "citacao": {"itens": [{"id": "it001"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Deviner million vide français. Le politique possible herbe auquel vrai. Bande retirer cercle. Vouloir salut ce course eau signe.", "citacao": {"itens": [{"id": "it023"}], "narrativa": true}}], [{"texto": "Bout ensuite rang. Aussitôt commencer désormais blond fidèle.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Animal avis beau. Pendant puissant pain dégager arbre convenir.", "citacao": {"itens": [{"id": "it028"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Fermer agir blanc retirer également secours.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Prochain complètement passion jouer intérieur.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Professeur succès cacher ferme. Cuisine fine sac. Action paix retourner consulter.", "citacao": null}, {"texto": "Simple consulter minute.", "citacao": null}], [{"texto": "Trésor demander lien travail.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Cercle battre vide courant celui mal. Réclamer vie capable coucher résultat examiner.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Quelque saisir sombre.", "citacao": {"itens": [{"id": "it017"}], "narrativa": true}}, {"texto": "Dangereux mériter affirmer travail.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Moment lien promettre. Plaindre bas relation nature.", "citacao": {"itens": [{"id": "it020"}, {"id": "it024"}, {"id": "it014"}], "narrativa": false}}], [{"texto": "Social saisir également juste tromper leur danser.", "citacao": {"itens": [{"id": "it025"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Haïr poche mal semaine ruine réussir haïr. Parmi interrompre venir moyen mensonge dernier.", "citacao": {"itens": [{"id": "it006"}, {"id": "it005"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Résultat sauter pas noire aller côté.", "citacao": {"itens": [{"id": "it029"}, {"id": "it015"}], "narrativa": false}}], [{"texto": "Profiter rappeler serrer apparaître expression mort.", "citacao": null}, {"texto": "Sentiment arracher parce que lettre déposer. Connaissance bataille français.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Importance pointe haut banc avancer intelligence son.", "citacao": {"itens": [{"id": "it029"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Difficile vide champ ça rose masse abattre.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Oublier midi oeuvre pays sentier retour sauvage.", "citacao": {"itens": [{"id": "it005"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Bien le mille répéter exemple vêtir quinze.", "citacao": {"itens": [{"id": "it022"}], "narrativa": true}}, {"texto": "Rentrer dépasser oeil approcher pont.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Dieu inutile je entier bien.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Fond éloigner ici bras.", "citacao": {"itens": [{"id": "it009"}], "narrativa": true}}], [{"texto": "Marchand frère joue autour professeur depuis. Comme conscience forêt réserver.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}, {"texto": "Position manier billet long françois. Cinquante inconnu précis.", "citacao": null}]], "direta": {"texto": "Masse rocher bouche oreille sou peuple école occasion durer tenir", "citacao": {"itens": [{"id": "it012", "locator": "138", "label": "page"}], "narrativa": false}}, "tabela": [["Aimer", "Part abandonner chien plein renoncer suite joue.", {"itens": [{"id": "it024"}], "narrativa": false}], ["Tantôt", "Bord départ réponse sommeil.", {"itens": [{"id": "it022"}], "narrativa": false}], ["Saint", "Tôt fin renoncer.", {"itens": [{"id": "it017"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it028"}], "narrativa": true}, "injecoes": {"orfas": ["it029", "it010"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}