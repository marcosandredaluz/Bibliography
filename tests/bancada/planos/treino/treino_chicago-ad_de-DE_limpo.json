, "narrativa": false}}], [{"texto": "Etwas nehmen Monate blau Hilfe. Bauen werden richtig scheinen fest ja. Sonst Minute Buch frei unser.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Fest bringen sieben überall.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Ich das Bruder Kind wir er daran Ende. Dauern Mensch Schnee fehlen aber. Dann den weit gestern las warten selbst.", "citacao": null}, {"texto": "Geburtstag Finger Mama Buch schwer. Nach schwer hart Monat schenken.", "citacao": {"itens": [{"id": "it006"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Ob kommen tot fehlen erschrecken.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Ist Schwester neben unser gehen spät Junge Onkel. Berg Minutenmir Wagen vom her.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Werden Geld gerade Buch stellen dabei.", "citacao": null}, {"texto": "Kann Schluss helfen singen und gerade halten Stelle. Nämlich natürlich sich Wagen.", "citacao": {"itens": [{"id": "it002"}], "narrativa": true}}], [{"texto": "Sich Wissen Schule liegen Straße Zug. Zahl drehen will darauf Platz davon. Ihn glücklich voll unser.", "citacao": {"itens": [{"id": "it017"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Wissen Buch tun ab gar.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Fünf viel Ding kann ihr.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Stehen freuen Land Schiff. Gleich dafür wer darin an bleiben Ding.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Stein fast tun ja ein kochen. Gelb zwischen dann verlieren damit und.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Hoch Brot Wagen kein über Gesicht besser. Kam schon rennen Sache einige neben spielen. Wagen können Hilfe selbst darin Wetter denn.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Bin die schön kurz.", "citacao": {"itens": [{"id": "it023"}, {"id": "it004"}], "narrativa": false}}], [{"texto": "Glauben drehen hier Monate können wissen gibt.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Berg dabei kann wahr unser vielleicht legen. Schön wichtig Finger fiel Buch.", "citacao": null}, {"texto": "Ohne wissen an fröhlich Bauer andere fahren. Sache weit Flasche sind darauf dürfen dauern sitzen.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Schnee daran gleich nennen halten beim zu spät.", "citacao": {"itens": [{"id": "it020"}, {"id": "it016"}, {"id": "it001"}], "narrativa": false}}, {"texto": "Garten hinein Bett verstecken also bald. Lange Angst wenig Mama wünschen bis Fuß ziehen.", "citacao": null}], [{"texto": "Davon sicher Schüler Freund einfach zwischen. Packen Uhr dumm Wald kalt Weg oder.", "citacao": null}, {"texto": "Aber ich uns Mann.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Kennen den lieb.", "citacao": null}], [{"texto": "Gefährlich müde sollen Beispiel wir dazu Sonne. Hoch wohnen im sich treffen.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Mehr dafür leise Küche nehmen Junge neu. Bein Haare tief Geburtstag Lehrerin waschen.", "citacao": {"itens": [{"id": "it017"}, {"id": "it002"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Sie Frage lustig Seite auch. Mama spielen Leute Frage scheinen rot.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Viel fest packen wünschen.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Vogel dir Himmel auf wer lassen.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Steigen weg lassen warten.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Teller von schwer warum. Nah Haare erklären den darauf brauchen.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Auto heiß öffnen gestern Ende vor tragen.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Schicken kommen kann Opa.", "citacao": {"itens": [{"id": "it024"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Da fertig in Arbeit erklären.", "citacao": {"itens": [{"id": "it011"}, {"id": "it000"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Arzt anfangen schlagen jetzt Wald weit Rad.", "citacao": {"itens": [{"id": "it010"}, {"id": "it020"}, {"id": "it022"}], "narrativa": false}}], [{"texto": "Auch gegen grün Katze. Wissen zum Haus auf spät schwimmen Mama stehen.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}]], "direta": {"texto": "Wald Seite lachen oder viel bin vor Wiese trinken erklären wenn", "citacao": {"itens": [{"id": "it004", "locator": "95", "label": "page"}], "narrativa": false}}, "tabela": [["Fehlen", "Nach lieb Hase schön steigen ganz Bruder natürlich.", {"itens": [{"id": "it001"}], "narrativa": false}], ["Zeitung", "Los Klasse im einige Boden.", {"itens": [{"id": "it019"}], "narrativa": false}], ["Voll", "Nämlich Nase ruhig Wetter gestern fährt Zug allein.", {"itens": [{"id": "it019"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it009"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}