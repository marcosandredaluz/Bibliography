re storico vivere camera evitare", "language": "it_IT", "issued": {"date-parts": [[2006]]}, "author": [{"family": "Dossetti-Parmitano", "given": "Arnaldo"}], "URL": "https://exemplo-treino.org/1774", "accessed": {"date-parts": [[2026, 11, 9]]}}, {"id": "extra1", "type": "thesis", "title": "Dipendere piccolo simile davvero energia moglie convincere frase", "language": "it_IT", "issued": {"date-parts": [[1987]]}, "author": [{"family": "Parpinel", "given": "Damiano", "non-dropping-particle": "dos"}, {"family": "Prati", "given": "Antonietta"}], "publisher": "Prodi SPA", "publisher-place": "Vestreno"}], "paragrafos": [[{"texto": "Piantare povero creare mentre dipendere possedere istante passione.", "citacao": {"itens": [{"id": "it005"}, {"id": "it017"}], "narrativa": false}}], [{"texto": "Età autorità parete.", "citacao": {"itens": [{"id": "it015"}, {"id": "it000"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Giocare potenza minimo militare polizia. Produzione bagno chiesa metro dovere voglia. Capello trarre offrire camera diretto e almeno.", "citacao": null}, {"texto": "Stagione monte voglia tanto fuoco stella meglio confronto. Qualunque alcuno povero peggio speranza aumentare studio.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Forza segretario diretto piede quarto procedere continuo punta.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Migliore preferire scorrere riuscire amare.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Riunire pubblicare sicuro condizione coprire costituire fumare. Figurare casa confronto fine. Rompere chiesa atto risolvere. Caso gettare uomo studio piazza.", "citacao": null}, {"texto": "Ragazza nudo povero divenire massimo. Perfino risposta fondo confessare minimo perfetto società.", "citacao": {"itens": [{"id": "it002"}], "narrativa": true}}], [{"texto": "Giungere peccato prevedere sorella giudizio signorina patria. Collina settimana animo altro qualsiasi osservare spalla.", "citacao": {"itens": [{"id": "it007"}], "narrativa": true}}], [{"texto": "Incontrare testa soprattutto vedere volto.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Fuori suonare memoria.", "citacao": {"itens": [{"id": "it011"}, {"id": "it019"}, {"id": "it004"}], "narrativa": false}}], [{"texto": "Romano campo intenzione segnare dimenticare. Ampio uscire qualcosa nazione necessità.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Tu seguire silenzio prevedere oggi. Amico posizione russo esistere qualità giardino piantare. Guardare insegnare università scienza camminare.", "citacao": {"itens": [{"id": "it020"}], "narrativa": true}}, {"texto": "Sonno senso serie soltanto mangiare pensiero.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Oggi comune dormire corso.", "citacao": {"itens": [{"id": "it004"}, {"id": "it019"}, {"id": "it006"}], "narrativa": false}}], [{"texto": "Compagno azzurro zia fame sbagliare età.", "citacao": {"itens": [{"id": "it020"}], "narrativa": true}}], [{"texto": "Prato basso bocca considerare. Muovere parlare giù finalmente cercare materia.", "citacao": {"itens": [{"id": "it002"}, {"id": "it005"}], "narrativa": false}}], [{"texto": "Bosco ombra domani pronto distanza chiamare.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Giardino affare popolo. Avanzare sotto comodo diventare contro.", "citacao": null}, {"texto": "Presenza letto discutere suo.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}, {"texto": "Accogliere peccato lira confronto polizia dentro insomma.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Comodo comune frutto rimettere sembrare.", "citacao": {"itens": [{"id": "it017"}, {"id": "it018"}, {"id": "it002"}], "narrativa": false}}], [{"texto": "Nessuno cultura giardino tenere pieno nazionale.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Affermare tuttavia partito cattolico momento pianura.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Difficile forse amore mercato.", "citacao": {"itens": [{"id": "it000"}, {"id": "it020"}], "narrativa": false}}], [{"texto": "Rimanere nome parete dimostrare potenza.", "citacao": {"itens": [{"id": "it004"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Paura militare sole sapere.", "citacao": {"itens": [{"id": "it020"}, {"id": "it001"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Fatica cattolico mese inglese brutto.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Bere riunire solo. Animale opinione vuoto scoppiare procedere sbagliare padrone. Volontà carta cominciare girare messa trovare.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Arrestare proposito qualche meritare senza corrente. Effetto poesia stare chiaro.", "citacao": null}, {"texto": "Stanco raggiungere prossimo puro minore trattare.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}], [{"texto": "Affare morire bagno attimo vestito.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Pericolo capitare partire armare pazzo. Rifiutare ritrovare esame montagna.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Poesia posizione silenzio casa argomento dio. Questione ragazzo tanto ciò misura.", "citacao": {"itens": [{"id": "it011"}, {"id": "it018"}], "narrativa": false}}], [{"texto": "Fino nome coraggio un oro sinistro un. Dipendere pietà assistere rivelare qualità verde. Grave riuscire allontanare attore.", "citacao": {"itens": [{"id": "it002"}, {"id": "it007"}, {"id": "it016"}], "narrativa": false}}]], "direta": {"texto": "Comporre tentare essa nord parlare con giusto stringere film mondo corso sotto cantare bambina tenere", "citacao": {"itens": [{"id": "it001", "locator": "225", "label": "page"}], "narrativa": false}}, "tabela": [["Dire", "Profondo contento marito ecco.", {"itens": [{"id": "it013"}], "narrativa": false}], ["Trovare", "Fiore fatica pazzo su ricerca scrivere.", {"itens": [{"id": "it000"}], "narrativa": false}], ["Volare", "Libero reale superare raccontare fenomeno bisogno.", {"itens": [{"id": "it018"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it012"}], "narrativa": true}, "injecoes": {"orfas": ["it000", "it020"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}