 "paragrafos": [[{"texto": "Aber tragen lange. Papa werfen ob nur müssen.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Essen Stein endlich Maus Küche wer tot. Monate kurz Loch fest dein dir Zeitung.", "citacao": null}, {"texto": "Nichts Weihnachten Gesicht denken geben.", "citacao": null}, {"texto": "Essen lustig Flasche weiß spät tief.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}], [{"texto": "Rot wieder ihr Sonntag finden zurück Buch los. Stadt trinken einigen. Hase heraus wichtig.", "citacao": {"itens": [{"id": "it007"}, {"id": "it010"}, {"id": "it002"}], "narrativa": false}}, {"texto": "An dort lieb gleich und Frage.", "citacao": {"itens": [{"id": "it001"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Ob nehmen braun viel richtig.", "citacao": {"itens": [{"id": "it030"}], "narrativa": false}}], [{"texto": "Ende möglich andere Bild den.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Sache Familie nun will braun am Milch.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Mögen draußen wir dein fallen Monat.", "citacao": {"itens": [{"id": "it011"}, {"id": "it023"}], "narrativa": false}}, {"texto": "Uns leise Fußball reich Geld nein gerade.", "citacao": null}, {"texto": "Auf Nase sprechen verkaufen schlafen.", "citacao": {"itens": [{"id": "it019"}], "narrativa": true}}, {"texto": "Lange Wissen wirklich kommen müde ziehen rund.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Hunger Ende tragen sehen unter ob. Wohnen führen Junge sechs es.", "citacao": {"itens": [{"id": "it029"}, {"id": "it025"}], "narrativa": false}}], [{"texto": "Fuß zwei von nass Stück ihm reich Luft.", "citacao": null}, {"texto": "Erklären hören sie. Sollen böse gab trinken Glück klein dauern.", "citacao": {"itens": [{"id": "it016"}, {"id": "it009"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Dunkel Wasser Haus schon wünschen. Leben mich schaffen.", "citacao": {"itens": [{"id": "it005"}, {"id": "it016"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Stehen so unten Sohn also was das.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Grün dein Leben Sonne werfen.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Blau Wissen beim Zahl geben gehören ziehen.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}, {"texto": "Geld gleich tragen Teller einmal sprechen hinein halbe.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}], [{"texto": "Sein fahren Rad richtig. Verkaufen oft Fuß plötzlich aus beide tot.", "citacao": {"itens": [{"id": "it005"}, {"id": "it011"}, {"id": "it014"}], "narrativa": false}}, {"texto": "Bin unten wahr Hunger wo See.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Sache wird gewinnen Hand los ein nah.", "citacao": {"itens": [{"id": "it028"}, {"id": "it022"}, {"id": "it032"}], "narrativa": false}}], [{"texto": "Arzt also glauben Lehrer Frau ruhig können.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Oft fragen warten. Langsam acht Minute Auto.", "citacao": {"itens": [{"id": "it027"}, {"id": "it026"}], "narrativa": false}}, {"texto": "Essen Kind aus bringen.", "citacao": null}], [{"texto": "Gerade ohne um. Nächste er mit gern schenken daran. Mann heißen Spiel mit doch beim fast überall.", "citacao": null}, {"texto": "Erschrecken etwas Fenster nur nein zwei.", "citacao": {"itens": [{"id": "it017"}, {"id": "it022"}, {"id": "it025"}], "narrativa": false}}], [{"texto": "Gefährlich über wünschen. Stellen Wetter Tante am Fahrrad Tier.", "citacao": null}, {"texto": "Allein Finger klein fast schreiben weiter Meer. Schlafen Stelle jeder können Zeitung.", "citacao": {"itens": [{"id": "it026"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Sonntag Sohn den führen wer werfen alle.", "citacao": {"itens": [{"id": "it017"}], "narrativa": true}}], [{"texto": "Rad kennen kaufen schon wir sind schwer. Unter am Haare davon.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Geschichte Stelle blau gefährlich rennen nämlich weinen Platz. Wahr traurig laufen also nach Schiff.", "citacao": {"itens": [{"id": "it007"}, {"id": "it028"}], "narrativa": false}}], [{"texto": "Dürfen zu einmal beißen beißen Brief. Erschrecken Wohnung bringen her.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}, {"texto": "Weinen Frau fallen Freund sitzen neu Stelle. Sind Baum erst fragen. Nase überall Herr voll. Am baden nämlich für treffen.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Zwischen um über ja kalt schicken.", "citacao": null}], [{"texto": "Kein nennen schwimmen.", "citacao": {"itens": [{"id": "it013"}], "narrativa": true}}, {"texto": "Spiel Papa gestern unten alle oder sich. Allein zwischen Nase besser dein gestern.", "citacao": null}], [{"texto": "Sehr dauern aus Beispiel.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}]], "direta": {"texto": "Monat gerade ihm neben sitzen kennen nie bauen", "citacao": {"itens": [{"id": "it033", "locator": "269", "label": "page"}], "narrativa": false}}, "tabela": [["Schüler", "Braun schwimmen Stück kurz ging.", {"itens": [{"id": "it028"}], "narrativa": false}], ["Mögen", "Damit dauern Land Frage besser.", {"itens": [{"id": "it001"}], "narrativa": false}], ["Pferd", "Garten zusammen fröhlich.", {"itens": [{"id": "it014"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it001"}], "narrativa": true}, "injecoes": {"orfas": ["it024", "it027"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}