te-parts": [[1997]]}, "author": [{"family": "Zänker", "given": "Concetta"}, {"family": "Kraus", "given": "Gaetano"}], "container-title": "Medical Mycology", "volume": "49", "issue": "8", "page": "589-600", "DOI": "10.99999/teste.treino.18829"}, {"id": "it022", "type": "webpage", "title": "Wo denken sich einigen merken zusammen öffnen neben", "language": "de_DE", "issued": {"date-parts": [[1997]]}, "author": [{"family": "Zänker", "given": "Concetta"}, {"family": "Kraus", "given": "Gaetano"}], "URL": "https://exemplo-treino.org/4172", "accessed": {"date-parts": [[2026, 11, 3]]}}, {"id": "extra0", "type": "article-journal", "title": "Licht draußen Arzt gelb leben Affe um erschrecken", "language": "de_DE", "issued": {"date-parts": [[1977]]}, "author": [{"family": "Lachmann-Zimmer", "given": "Horst"}], "container-title": "Preventive Veterinary Medicine", "volume": "39", "issue": "8", "page": "852-867", "DOI": "10.99999/teste.treino.66829"}, {"id": "extra1", "type": "article-journal", "title": "Sommer Katze Seite rechnen warten aber Eltern lustig stellen packen Auto", "language": "de_DE", "issued": {"date-parts": [[2009]]}, "author": [{"family": "Eberth", "given": "Lore", "non-dropping-particle": "de"}, {"family": "Gotthard", "given": "Ljubica"}], "container-title": "Epidemiologia & Prevenzione", "volume": "77", "issue": "10", "page": "63-83"}], "paragrafos": [[{"texto": "Teller draußen reiten nein.", "citacao": {"itens": [{"id": "it009"}, {"id": "it001"}], "narrativa": false}}, {"texto": "Schicken sie groß nass versuchen tragen dabei.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Da denken später noch Licht Mama.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Fiel fragen singen Ferien Wasser Spaß.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Laut Hunger als vergessen werfen Glas.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Dir Geburtstag Musik gelb laufen letzte Himmel. Dürfen um Rad Küche.", "citacao": null}, {"texto": "Als glücklich schreien Affe warm bringen Eltern Zimmer. Boden dann bekommen wichtig antworten erschrecken. Weil Tür hat halten aus.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Von stark mal. Ob mal Ball schreien Wort schlafen fahren wünschen. Ruhig erklären Land Glas vor Feuer uns.", "citacao": null}, {"texto": "Fertig danach seit voll bin sieben einmal. Warten Sohn als gestern.", "citacao": null}], [{"texto": "Glücklich dunkel sollen es Tisch gelb Wasser. Lange Baum müde schwarz.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Küche Stadt heiß springen Schluss daran Seite. Stelle reiten beide hinein. Möglich sonst rennen der. Nie finden stehen.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Hund Mensch zehn Nase gibt er.", "citacao": {"itens": [{"id": "it019"}, {"id": "it016"}, {"id": "it005"}], "narrativa": false}}], [{"texto": "Mutter schlecht Ferien nehmen.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Sonntag beide Frau führen wird steigen jeder Kind. Glück genau Auge Apfel schon Sache.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Blau merken frei hier warten brauchen sollen.", "citacao": null}], [{"texto": "Schwester freuen Finger bekommen führen Sonntag nimmt. Gewinnen hat Fuß. Ging turnen zu daran Ding traurig es Land.", "citacao": {"itens": [{"id": "it022"}, {"id": "it015"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Mensch bald dunkel neun gerade wieder Eltern Brief. Hilfe hat blau.", "citacao": null}], [{"texto": "Traurig vielleicht Herz Hilfe so.", "citacao": null}], [{"texto": "Uhr um trinken und Haus besser.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Opa fressen Kind Spiel traurig. Ende treffen nehmen Licht. Stunde Fisch Haus stellen leicht dazu Hilfe. Bekommen vor Haus wünschen sie Woche.", "citacao": null}], [{"texto": "Nase Auto zusammen böse warten halbe.", "citacao": null}, {"texto": "Zusammen schwarz Schnee ein. Vom glauben Schüler heute gab lesen singen. Weil suchen oder leise Beispiel. Das hängen ich Bruder nur heraus steigen.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Wohl immer ab immer ziehen richtig klein Schluss.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Drei Frage kann vier.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Baum stark früher hart weiter darauf Geld.", "citacao": {"itens": [{"id": "it013"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Wahr klettern Zug anfangen vor. Deshalb Schwester freuen Klasse antworten hin draußen wer. Sitzen wir nämlich früh fragen.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Ein einmal lustig Stück groß Luft und vom.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Helfen hinter Apfel schreien uns. Geben sieht nah nächste See er sonst.", "citacao": null}, {"texto": "Jahr Monat heraus nah merken bleiben. Stark dunkel Dorf Sonntag Kind laufen.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Dann stark nun Geburtstag. Mein genau legen antworten ging. Stadt zu aus los Monate. Gegen Welt Musik.", "citacao": {"itens": [{"id": "it011"}, {"id": "it020"}], "narrativa": false}}], [{"texto": "Abend wieder rund reich nämlich darauf.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Woche Welt jetzt groß denn finden.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Mein Sache baden sehr Wagen durch ihr.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Erst er setzen möglich vom verstecken.", "citacao": {"itens": [{"id": "it018"}, {"id": "it001"}, {"id": "it004"}], "narrativa": false}}], [{"texto": "Angst immer Hilfe dem scheinen vom. Fröhlich Zahl mit.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Mama letzte neben zwei. Schicken dir müssen Essen Monat freuen Stadt.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Weinen wahr Haus danach.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Hören Monate Eltern sind Dorf.", "citacao": {"itens": [{"id": "it006"}, {"id": "it018"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Onkel schwer Weihnachten.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Zeit Spaß Küche letzte lange braun. Oma weil Bild Vogel mit gleich. Sehen zum wir nie war trinken böse.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Stein legen stellen weinen schlafen in.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Brief klettern frei haben hinter.", "citacao": null}], [{"texto": "Zehn anfangen werden.", "citacao": {"itens": [{"id": "it022"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Frage zehn laut Schnee Sonne Arbeit. Leise Schiff später Angst gehen blau. Stadt kommen Essen bis Lehrer.", "citacao": {"itens": [{"id": "it004"}, {"id": "it010"}], "narrativa": false}}], [{"texto": "Essen auf Papa bin. Vier Mensch fahren Apfel Freund Schiff.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Sich Spaß Straße ziehen. Gerade ihm nah Wort acht Mann lange ihn. Wird verstecken Schluss leben Schwester.", "citacao": null}], [{"texto": "Allein spielen Schüler sehr Feuer Buch. Braun Stein ins Schule.", "citacao": {"itens": [{"id": "it002"}, {"id": "it005"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Wichtig wer schwarz Schwester.", "citacao": null}, {"texto": "Ich also Zimmer Jahr. So ruhig Sommer Hilfe bald.", "citacao": {"itens": [{"id": "it010"}, {"id": "it008"}, {"id": "it022"}], "narrativa": false}}]], "direta": {"texto": "Schnell danach Name in dauern dauern hat also packen braun Zahl darauf", "citacao": {"itens": [{"id": "it003", "locator": "101", "label": "page"}], "narrativa": false}}, "tabela": [["Tag", "Sommer Winter man über werfen versuchen.", {"itens": [{"id": "it010"}], "narrativa": false}], ["Über", "Gefährlich Welt Garten scheinen Gesicht.", {"itens": [{"id": "it013"}], "narrativa": false}], ["Genau", "Schön Papa zum sehen.", {"itens": [{"id": "it002"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it003"}], "narrativa": false}, "injecoes": {"orfas": ["it019", "it002"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}