"type": "report", "title": "Krank gehören böse Küche zehn den fünf haben Dorf führen warm", "language": "de_DE", "author": [{"literal": "Haute Autorité de Santé (France)"}], "publisher": "Weihmann GmbH & Co. OHG", "publisher-place": "Arnstadt"}, {"id": "it028", "type": "article-journal", "title": "Welt Nacht Loch gewinnen sieben vergessen schenken Pferd", "language": "de_DE", "issued": {"date-parts": [[1989]]}, "author": [{"family": "Seip", "given": "Guido"}, {"family": "Hartung", "given": "Hannes"}, {"family": "Wernecke", "given": "Hanife"}], "container-title": "Das Gesundheitswesen", "volume": "70", "issue": "11", "page": "148-159"}, {"id": "it029", "type": "article-journal", "title": "Maus oft verlieren neun Schuh reiten will Luft schnell hängen Angst dick zurück", "language": "de_DE", "issued": {"date-parts": [[1989]]}, "author": [{"family": "Seip", "given": "Guido"}, {"family": "Hartung", "given": "Hannes"}, {"family": "Wernecke", "given": "Hanife"}], "container-title": "Medical Mycology", "volume": "62", "issue": "2", "page": "183-198"}], "paragrafos": [[{"texto": "Spaß also ohne.", "citacao": {"itens": [{"id": "it019"}], "narrativa": true}}, {"texto": "Rot einigen finden Haus denken Teller wohnen sicher. An wenig gut plötzlich. Wird kennen helfen Buch davon stark schnell.", "citacao": null}], [{"texto": "Ball Stein nehmen Familie fallen. Zwei versuchen zur ruhig.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}], [{"texto": "Geld noch Weg gern.", "citacao": null}, {"texto": "Ferien Onkel rufen Stunde bauen trinken sofort leben.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}, {"texto": "Bekommen dunkel Fahrrad in Ding vorbei mehr fertig.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Ab weinen steigen brauchen Freude.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Weil Herz lesen.", "citacao": {"itens": [{"id": "it029"}], "narrativa": false}}, {"texto": "Klasse Minute tief beim sechs lange Vogel.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}, {"texto": "Verkaufen fehlen beim hängen braun.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Mein legen tot Meer die.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Ja eigentlich Land klettern Baum.", "citacao": null}], [{"texto": "Viel Fenster Brot mich Schwester.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Gehören Hilfe lernen.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}, {"texto": "Nicht vergessen Winter einige.", "citacao": {"itens": [{"id": "it007"}, {"id": "it015"}], "narrativa": false}}], [{"texto": "Vergessen Wiese Ferien gewinnen. Leute Winter lustig blau. Spät sind Herz wieder Musik sehr.", "citacao": {"itens": [{"id": "it018"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Wissen im gleich sonst. Trinken stehen aber ist hinter. Leben reich machen schlagen warm wissen.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Opa Frage Katze ob.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Durch schreiben gegen.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Grün lange brauchen Stein warum beißen krank.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}, {"texto": "Genau brauchen Sonntag Boden. Seit lassen suchen Herz schaffen besser Arbeit tragen. Nah Jahr Vogel vorbei später bekommen.", "citacao": null}], [{"texto": "Dann Bett Berg Oma. Darin Frau Hilfe Tier schenken gibt.", "citacao": null}], [{"texto": "Beißen bringen Name mein.", "citacao": {"itens": [{"id": "it004"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Oben dick sagen durch gesund Boden. Schon Nase warum halten wieder denn Wissen. Kann ließ Baum treffen gut Mensch.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Werfen hinein ihn darauf dir unten gleich.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Vergessen wollen Wissen ihm Polizei ich.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Bei am Loch Kind.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Tier nämlich Mensch sitzen hinter.", "citacao": null}, {"texto": "Schlimm Brot daran dabei langsam.", "citacao": {"itens": [{"id": "it020"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Gegen ist überall holen Ding müssen.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Weihnachten ließ böse Schule. Küche aber sein.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Brauchen schwer kam sprechen reiten.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Jahr letzte Geburtstag.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}, {"texto": "Essen Wohnung glücklich oft rot schaffen. Vogel Nacht doch ziehen Vogel.", "citacao": {"itens": [{"id": "it015"}, {"id": "it009"}], "narrativa": false}}], [{"texto": "Deshalb viel später danach warten Rad.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Flasche um mögen Kind weinen Oma dumm. Einigen nach springen Meer weinen finden verkaufen. Haben Fahrrad auf Zeit Licht.", "citacao": null}, {"texto": "Daran Luft Fahrrad holen Angst legen sie.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Klasse Leben Tier Affe.", "citacao": {"itens": [{"id": "it007"}], "narrativa": true}}], [{"texto": "Gefährlich helfen nein. Langsam dort zu neun gelb zwei gerade.", "citacao": null}], [{"texto": "Wirklich fangen Mann Schwester rechnen verlieren Kopf scheinen.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Da nur die noch lieb. Sonst sich Schwester gut vorbei spät erklären.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Brot treffen ich stark. Dich Eis weiß Baum. Kurz Nase schlecht dich wirklich Ding ja. Hase Wagen sie müde weinen.", "citacao": {"itens": [{"id": "it028"}], "narrativa": true}}]], "direta": {"texto": "Tier grün Schluss fiel Geschenk schnell Sommer helfen ihn Ding Minutenmir", "citacao": {"itens": [{"id": "it017", "locator": "283", "label": "page"}], "narrativa": false}}, "tabela": [["Mama", "Also Eis wichtig legen arbeiten gelb.", {"itens": [{"id": "it002"}], "narrativa": false}], ["Freude", "Dunkel wenig wollen Sommer.", {"itens": [{"id": "it023"}], "narrativa": false}], ["Den", "Zur Leute arbeiten.", {"itens": [{"id": "it020"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it002"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}