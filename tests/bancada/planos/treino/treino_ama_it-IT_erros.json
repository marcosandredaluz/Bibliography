false}}, {"texto": "Presso oramai sguardo preciso bruciare orecchio.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Direttore sociale trovare minore mezzo intendere matrimonio.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Sorridere portare difficile croce. Attore nemmeno strano finire divertire rappresentare puro.", "citacao": {"itens": [{"id": "it009"}, {"id": "it019"}], "narrativa": false}}], [{"texto": "Ricordo entro popolo giornale. Migliore presente bisogno attorno ufficiale riuscire.", "citacao": {"itens": [{"id": "it001"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Atto donna pelle sud fantasia correre. Frase gioia mancare tedesco arrivare.", "citacao": {"itens": [{"id": "it030"}, {"id": "it014"}], "narrativa": false}}], [{"texto": "Concetto pena attento contro.", "citacao": {"itens": [{"id": "it008"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Milione pazzo divenire esso madre troppo.", "citacao": {"itens": [{"id": "it028"}, {"id": "it032"}], "narrativa": false}}, {"texto": "Interno sole strano rapporto formare.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Girare sostenere luogo molto. Breve guardia portare fumare volere portare.", "citacao": {"itens": [{"id": "it003"}, {"id": "it032"}], "narrativa": false}}, {"texto": "Questione rendere immaginare utile normale.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Paura innamorare andare quasi. Scena se strano su interesse.", "citacao": null}, {"texto": "Difficoltà ah distinguere frutto labbro studiare segreto li.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Numeroso cuore nuovo.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Creare posare straordinario fermo nostro evitare. Fuori perché mattino notizia internazionale prodotto. Latino raccontare prova stupido dovere.", "citacao": {"itens": [{"id": "it032"}], "narrativa": false}}, {"texto": "Scherzare confessare capo vestire.", "citacao": {"itens": [{"id": "it025"}, {"id": "it029"}, {"id": "it010"}], "narrativa": false}}], [{"texto": "Vivo stagione fronte spegnere sorriso fianco ricco. Di certamente confessare espressione.", "citacao": null}, {"texto": "Pietà unire differenza privato fuori aiutare momento dito. Attaccare con padrone senza. Animale vino mentre spingere qualche domenica punta.", "citacao": null}, {"texto": "Tanto diverso vivere rimanere.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Tutto bianco maniera divenire gioia cucina. Contatto naturale opporre fissare.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Tedesco padre calcio dormire inizio.", "citacao": {"itens": [{"id": "it011"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Teatro governo produzione stato mantenere macchina.", "citacao": {"itens": [{"id": "it012"}, {"id": "it001"}, {"id": "it032"}], "narrativa": false}}], [{"texto": "Minimo tentare rivedere quello. Giardino alzare battere resto sopra recente animale. Romano produzione direttore avere ricerca permettere.", "citacao": null}, {"texto": "Momento piccolo verso inizio condurre qualcuno. Stanco questione tutto povero distruggere.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Intendere corrente affermare.", "citacao": {"itens": [{"id": "it022"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Aiuto capitare figlio.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Vecchio marito vestito personale perfino partecipare.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Sorella superare spesa domani. Contadino elemento strada iniziare labbro faccia sacro.", "citacao": {"itens": [{"id": "it011"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Nobile tavola signore accadere oltre greco. Paura stagione inutile favore eh povero sociale direzione.", "citacao": null}], [{"texto": "Ultimo appena bagno dio professore. Raggiungere domani recente diventare discorso vero. Guidare minore libro errore grave.", "citacao": {"itens": [{"id": "it020"}, {"id": "it029"}, {"id": "it005"}], "narrativa": false}}], [{"texto": "Pure bene discorso dio fianco puro luogo. Religioso memoria limite vario.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}, {"texto": "Volere essere mantenere soltanto.", "citacao": {"itens": [{"id": "it014"}, {"id": "it019"}], "narrativa": false}}], [{"texto": "Bosco assumere entro ringraziare.", "citacao": null}, {"texto": "Qualcuno inutile rosso don civile ferro.", "citacao": null}, {"texto": "Gridare personale voce oggetto comporre andare.", "citacao": null}], [{"texto": "Minore pane contatto latte conoscenza. Posare spiegare animale portare. Risultare in civiltà attorno ordinare.", "citacao": {"itens": [{"id": "it004"}], "narrativa": true}}], [{"texto": "Lato autore controllo pensiero.", "citacao": {"itens": [{"id": "it010"}, {"id": "it023"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Dentro che vi. Caldo consentire milione costituire oggi. Provocare ultimo regione.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}]], "direta": {"texto": "Riuscire grosso raccogliere ognuno animo parlare sacro paese lingua indietro", "citacao": {"itens": [{"id": "it010", "locator": "256", "label": "page"}], "narrativa": false}}, "tabela": [["Territorio", "Nascere per qualunque pezzo aiuto.", {"itens": [{"id": "it014"}], "narrativa": false}], ["Politico", "Altro arrestare passare cortile gettare grave.", {"itens": [{"id": "it009"}], "narrativa": false}], ["Ufficio", "Momento giovane levare bruciare il difesa vasto automobile.", {"itens": [{"id": "it013"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it015"}], "narrativa": true}, "injecoes": {"orfas": ["it029", "it026"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}