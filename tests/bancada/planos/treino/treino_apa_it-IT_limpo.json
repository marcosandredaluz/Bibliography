 "Pubblico luogo colpo completamente raggiungere allontanare figlio lontano portare vento affatto piangere", "language": "it_IT", "issued": {"date-parts": [[2019]]}, "author": [{"family": "Aldobrandi", "given": "Coluccio"}, {"family": "Casini", "given": "Pietro"}, {"family": "Vergassola", "given": "Arsenio"}], "container-title": "Cadernos de Saúde Pública", "volume": "16", "issue": "11", "page": "826-846"}], "paragrafos": [[{"texto": "Infine dedicare memoria portare avere pomeriggio. Addirittura repubblica lotta.", "citacao": {"itens": [{"id": "it010"}, {"id": "it027"}], "narrativa": false}}, {"texto": "Ufficiale amico facile basso nascere limite scala neanche.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Titolo grazie più privato discorso studio risultare insieme.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Ci teatro libro leggere.", "citacao": {"itens": [{"id": "it030"}], "narrativa": false}}], [{"texto": "Nave qui contadino tranquillo personale. Solo quello alto difendere situazione.", "citacao": {"itens": [{"id": "it023"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Verso principio lanciare pianura affrontare.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}, {"texto": "Contrario dimenticare leggere.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Oggetto essere battere si contadino loro pietà ferire.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Perché decidere fissare macchina conoscenza.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Uomo convincere apparire legare dichiarare serie procedere cortile. Desiderare tenere ricchezza rapporto fissare.", "citacao": null}], [{"texto": "Collo intorno istante attaccare.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Guardia industria contro sorprendere raccogliere sedere. Ammettere chiamare atto fame questo partito pieno. Udire attore ufficio figura diventare appena.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Proposta escludere decisione politico. Insieme porre guidare corso dividere servizio.", "citacao": {"itens": [{"id": "it032"}], "narrativa": false}}], [{"texto": "Età mio normale bocca. Stasera secolo considerare matrimonio punto ricordo colpire. Molto eccetera trasformare discutere pomeriggio sviluppo voglia.", "citacao": {"itens": [{"id": "it032"}], "narrativa": true}}, {"texto": "Puro attore leggere zona.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Domandare serie grazia comunicazione sorgere ogni pianura. Sapere spettacolo conservare animo opera classe.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Fermare descrivere storico stabilire.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}, {"texto": "Dire oltre aiutare uguale accadere pietà.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Qualche sperare suo cadere dio volto lungo.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Autorità sedere programma udire ridere regno unire.", "citacao": {"itens": [{"id": "it021"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Folla relazione soltanto posto.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Chiaro coloro energia corpo prodotto.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}, {"texto": "Riportare procedere tanto salutare qualcuno luogo rimettere.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Albergo mancare gatto maniera.", "citacao": null}, {"texto": "Tanto ambiente strada colore udire giorno contare.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Stato presidente avvocato riconoscere estate che avanti.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}], [{"texto": "Giudicare centro piede rosso restare fino. Impossibile programma contro situazione allora. Soltanto osservare neppure pace succedere.", "citacao": null}, {"texto": "Piangere lato vento ragione.", "citacao": {"itens": [{"id": "it018"}], "narrativa": true}}], [{"texto": "Soluzione zitto stesso determinare.", "citacao": null}, {"texto": "Lei fantasia permettere origine sorridere quello assumere. Milione là latte apparire favore.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Costruzione stagione proprio.", "citacao": null}, {"texto": "Civile lato volontà raggiungere domanda voltare.", "citacao": {"itens": [{"id": "it029"}], "narrativa": false}}], [{"texto": "Arma sottile oro meglio odore monte distinguere.", "citacao": {"itens": [{"id": "it032"}], "narrativa": false}}], [{"texto": "Tranquillo ricordo sera intero provincia verde qualunque.", "citacao": null}, {"texto": "Età completamente posto qualsiasi.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}, {"texto": "Valle adesso angolo vi caso concedere.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Pagare successo verso crescere colpa. Impedire rispondere sacro sorgere dunque posare.", "citacao": {"itens": [{"id": "it020"}], "narrativa": true}}, {"texto": "Parete lasciare bagno poeta scorrere impossibile comprare. Molto alzare domandare indicare a professore fuoco.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Difficile capace scrittore effetto presto facile gamba.", "citacao": {"itens": [{"id": "it026"}, {"id": "it021"}], "narrativa": false}}, {"texto": "Stampa infine dito differenza capello congresso.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Signorina ricchezza dichiarare cortile vivere. Contare riguardare accanto presto solo lira.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Assai stringere polizia giudizio.", "citacao": null}], [{"texto": "Valere considerare bianco stasera girare croce processo. Costringere uccidere buio porto chiesa. Compagnia punto coraggio leggere. Passare religioso rappresentare volta festa niente naturalmente.", "citacao": {"itens": [{"id": "it022"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Temere destro sereno discorso gatto malattia.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}]], "direta": {"texto": "Comodo infine escludere sì costruire mangiare triste parlare nord testa trattare scorrere ministro intanto", "citacao": {"itens": [{"id": "it004", "locator": "98", "label": "page"}], "narrativa": false}}, "tabela": [["Accettare", "Capitare superiore nostro carattere scala fede.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Veramente", "Comprendere pelle porre cattolico ascoltare ridere.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Incontrare", "Senso leggere osservare badare scrittore.", {"itens": [{"id": "it011"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it020"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}