ps://leis-treino.gov/5233"}, {"id": "extra1", "type": "article-journal", "title": "Cristiano pelle mano energia", "language": "it_IT", "issued": {"date-parts": [[1978]]}, "author": [{"family": "Lamborghini", "given": "Graziella", "non-dropping-particle": "de"}], "container-title": "Gaceta Sanitaria", "volume": "54", "issue": "12", "page": "643-648", "DOI": "10.99999/teste.treino.37614"}], "paragrafos": [[{"texto": "A luce congresso limitare esame durare.", "citacao": {"itens": [{"id": "it025"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Conto grande dente crescere discutere.", "citacao": {"itens": [{"id": "it015"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Decisione tecnico si cioè.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Anno cattolico quale calcio.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Caso sereno nazionale fratello sogno sud. Attività serie aiutare qualità. Anche scrivere saltare nudo.", "citacao": {"itens": [{"id": "it030"}], "narrativa": false}}, {"texto": "Si operaio completamente coscienza ritrovare concedere stabilire.", "citacao": {"itens": [{"id": "it030"}, {"id": "it028"}], "narrativa": false}}], [{"texto": "Giugno merito sostenere commissione serie. Comodo cura tale passione cuore sede destino.", "citacao": {"itens": [{"id": "it008"}, {"id": "it020"}], "narrativa": false}}], [{"texto": "Cittadino capello alcuno azzurro contatto.", "citacao": {"itens": [{"id": "it007"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Costa ripetere capello trovare porre secolo.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Don aggiungere minimo egli confronto sangue. Città orecchio corrente massimo colpa letto notevole.", "citacao": {"itens": [{"id": "it030"}], "narrativa": false}}, {"texto": "Caffè scomparire ufficiale lavoro spiegare ricchezza momento.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Uccidere carattere esporre rosso riferire titolo bello istante.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}, {"texto": "Rapido principio tornare militare sedere vostro. Quasi mondo fine stazione segreto vento elemento neppure.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Tempo rompere sonno passo gusto.", "citacao": {"itens": [{"id": "it009"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Ridere né istante sinistro sostenere cantare consiglio.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Tipo stagione consiglio guerra romano amare bambina. Bagno fermo accorgersi ammazzare allontanare cuore quasi. Nero origine ricevere leggero.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}, {"texto": "Dottore poco ospedale.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Migliore compagnia ministro. Inverno oppure appunto ferire assistere.", "citacao": {"itens": [{"id": "it005"}], "narrativa": true}}], [{"texto": "Prossimo confessare dubbio villa nuovo numeroso. Ringraziare guardia interno marito guardare intero. Dito richiedere infatti trasformare sopra.", "citacao": {"itens": [{"id": "it017"}, {"id": "it023"}], "narrativa": false}}], [{"texto": "Osservare distruggere rappresentare dinanzi.", "citacao": {"itens": [{"id": "it017"}, {"id": "it016"}], "narrativa": false}}, {"texto": "Salire giornale qui tedesco massimo possibilità spettacolo appartenere.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Rosso tono vicino. Quello civile intendere risultato.", "citacao": null}], [{"texto": "Affrontare facile sud pranzo legge fuoco corsa. Arma per saltare pranzo. Fortuna gamba brutto istante rivelare.", "citacao": {"itens": [{"id": "it030"}, {"id": "it005"}], "narrativa": false}}, {"texto": "Compiere gamba straniero tentare vecchio trarre essere cominciare. Pietà fretta qualcuno monte rispondere contatto.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Stupido sorella funzione con nuovo posizione proposito. Più religioso tuttavia tra accogliere. Tale assumere riunire porta svolgere.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Albergo libro più.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Distanza condizione lanciare straordinario misura sì. Pranzo più colpire confronto gridare.", "citacao": {"itens": [{"id": "it025"}, {"id": "it016"}], "narrativa": false}}], [{"texto": "Preferire rivedere nemico.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Resistere ombra tacere giusto dolore rimanere nascondere.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Funzione offrire libro ragazzo esempio costituire.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}], [{"texto": "Palazzo film soffrire sud. Superare automobile lato americano.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Argomento padre grosso.", "citacao": null}, {"texto": "Inverno servire aumentare dividere abbastanza.", "citacao": {"itens": [{"id": "it024"}], "narrativa": true}}], [{"texto": "Addosso peccato cercare ridurre innamorare termine.", "citacao": null}, {"texto": "Gesto bianco riunire costituire gatto ricevere. Ritorno nome erba affatto ma impedire pomeriggio. Il possibile stamattina.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Avanzare anche eh legge vasto si mandare tornare.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Testa compiere noi matrimonio francese.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Azione pericoloso necessità valle adesso. Rompere numero oltre americano solo concedere.", "citacao": {"itens": [{"id": "it029"}, {"id": "it026"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Camminare tuttavia tornare scena grado piazza. Croce festa zia.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Altro cane avere sostenere sociale diffondere.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Cercare interno nobile accompagnare qualità maniera.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Alcuno foglia mostrare situazione qua qualità sbagliare. Comprendere letto libro. Posizione futuro se resto con.", "citacao": {"itens": [{"id": "it031"}, {"id": "it026"}], "narrativa": false}}, {"texto": "Intendere compagno spalla ancora parlare. Tra tono annunciare ne circa dietro.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Posare perciò folla legge disposizione caldo. Notte speranza partecipare nudo. Tutto argomento ora internazionale.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Patria braccio superiore rimettere.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Comporre discutere prendere stella contare minore quasi.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Signora raccontare no rifiutare condurre pieno.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}]], "direta": {"texto": "Confessare contrario insegnare programma limite legare onore mercato quale svolgere attendere", "citacao": {"itens": [{"id": "it031", "locator": "75", "label": "page"}], "narrativa": false}}, "tabela": [["Bisognare", "Breve insistere coscienza o chiaro oltre immaginare.", {"itens": [{"id": "it004"}], "narrativa": false}], ["Giungere", "Bisogno consiglio domanda completamente rispondere medesimo altro proposta.", {"itens": [{"id": "it020"}], "narrativa": false}], ["Presidente", "Importanza parete coloro aggiungere.", {"itens": [{"id": "it019"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it001"}], "narrativa": true}, "injecoes": {"orfas": ["it020", "it006"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}