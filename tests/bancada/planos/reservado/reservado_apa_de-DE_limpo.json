type": "webpage", "title": "Gleich Tisch zur den Feuer blau verstehen Fußball wohl schwer", "language": "de_DE", "issued": {"date-parts": [[2001]]}, "author": [{"family": "Heinz", "given": "Patric"}], "URL": "https://exemplo-reservado.org/6646", "accessed": {"date-parts": [[2026, 11, 1]]}}, {"id": "it018", "type": "legislation", "title": "Trinken fertig Frau Freude schon holen mich Geburtstag will später", "language": "de_DE", "issued": {"date-parts": [[2011]]}, "author": [{"literal": "Agenzia Italiana del Farmaco"}], "number": "10959", "URL": "https://leis-reservado.gov/248"}, {"id": "it019", "type": "chapter", "title": "Minutenmir Seite Baum Brief Tante zwischen sechs", "language": "de_DE", "author": [{"family": "Tschentscher", "given": "Katja"}], "container-title": "Denken jung setzen Minute Frau gesund Wagen weiter ziehen Essen Name spät", "publisher": "Drub KG", "publisher-place": "Kelheim", "editor": [{"family": "Thanel", "given": "Amir"}], "page": "31-46"}, {"id": "it020", "type": "legislation", "title": "Wird dauern Loch Sohn Erde", "language": "de_DE", "issued": {"date-parts": [[1984]]}, "author": [{"literal": "Agenzia Italiana del Farmaco"}], "number": "7083", "URL": "https://leis-reservado.gov/3080"}, {"id": "it021", "type": "webpage", "title": "Nicht weit Geburtstag Leute oben wo im Hase sie schicken tief Glas kennen", "language": "de_DE", "issued": {"date-parts": [[1984]]}, "author": [{"literal": "Agenzia Italiana del Farmaco"}], "URL": "https://exemplo-reservado.org/7630", "accessed": {"date-parts": [[2026, 11, 10]]}}], "paragrafos": [[{"texto": "Schenken Arbeit erklären oder.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Weil Herr nennen führen schauen gelb eigentlich.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}, {"texto": "Geschichte drei fertig sieht Geschichte im Finger.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}], [{"texto": "Schüler richtig Sonntag Schluss voll holen.", "citacao": {"itens": [{"id": "it000"}, {"id": "it019"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Sprechen wir Beispiel Minute Polizei.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Schlecht schlimm rennen müde Küche Fuß. Bekommen ab mögen stark. Land lange nah her.", "citacao": null}], [{"texto": "Ball hin Wiese alt rechnen stehen hinein. Fliegen viel fallen Abend Mama.", "citacao": {"itens": [{"id": "it017"}], "narrativa": true}}], [{"texto": "Essen Junge zum.", "citacao": {"itens": [{"id": "it017"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Wissen Name Küche gesund. Sich ziehen Sohn wollen singen. Sechs jeder Schuh klettern kann helfen erschrecken.", "citacao": {"itens": [{"id": "it002"}, {"id": "it005"}], "narrativa": false}}, {"texto": "Anfangen alle unser ob.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Vergessen kochen nicht gesund davon darauf.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Müde Woche dauern draußen leise.", "citacao": null}, {"texto": "Her Sonne frei Sache Feuer.", "citacao": {"itens": [{"id": "it005"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Dort öffnen bei Frage Zimmer seit fünf.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Dort damit mehr ist wohl gestern. Affe fallen ihr Himmel Zahl die kalt.", "citacao": null}, {"texto": "Besser zwei Zeitung nennen groß Rad.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Garten dazu endlich hoch.", "citacao": null}, {"texto": "Feuer Bett noch wird für dazu.", "citacao": null}, {"texto": "Gerade nennen schon. Sonntag Leben Minute versuchen.", "citacao": null}], [{"texto": "Wissen ein Klasse sollen aus. Heißen weit neu Mädchen. Fenster lange sieht Auge wie böse Zeit draußen.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Natürlich Stein davon liegen genau.", "citacao": null}, {"texto": "Kein Name Meer ziehen Loch Nase.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Beide der beißen Arzt. Weinen warten mehr schauen leise Baum fünf immer.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Tief sie öffnen natürlich. Endlich Brief Straße schlagen schauen andere. Beide holen Meer wirklich vier viel Fußball.", "citacao": {"itens": [{"id": "it004"}, {"id": "it000"}, {"id": "it006"}], "narrativa": false}}], [{"texto": "Halten Pferd oder schenken ohne ließ. Seit es Baum. Mehr im das wahr Schiff arbeiten.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}, {"texto": "Halten Zug Brot kommen Tier einigen laufen ließ.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Spät Spiel wo schaffen lieb Haare Mensch Zimmer.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Selbst Ball darauf zwei Zug wichtig baden.", "citacao": null}, {"texto": "Kopf machen vom kaufen viel vor oben. Plötzlich voll hart hin fragen Leben.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Schule deshalb möglich turnen.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}], [{"texto": "Ging früh rufen Hund mehr.", "citacao": {"itens": [{"id": "it008"}, {"id": "it002"}], "narrativa": false}}, {"texto": "Sehr Essen Teller Schuh Freund steigen vorbei.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Essen lieb überall so kochen Herz scheinen kommen.", "citacao": {"itens": [{"id": "it007"}], "narrativa": true}}, {"texto": "Schauen Sonne Monat Ferien haben Sache dazu.", "citacao": {"itens": [{"id": "it016"}, {"id": "it017"}], "narrativa": false}}], [{"texto": "Seit Tier sprechen drei liegen darauf heraus. Schwer tun warum voll. Klettern packen erzählen ihr Bauer Onkel.", "citacao": {"itens": [{"id": "it013"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Richtig an Hunger lesen Vater. Weihnachten Eis kochen verkaufen.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}]], "direta": {"texto": "Schnell Boden alle verlieren warm Leute seit zusammen Vogel Musik böse Tante wie zurück", "citacao": {"itens": [{"id": "it010", "locator": "103", "label": "page"}], "narrativa": false}}, "tabela": [["Nächste", "Jetzt Schuh wieder Geburtstag Teller Geschenk Onkel erklären.", {"itens": [{"id": "it009"}], "narrativa": false}], ["Wird", "Her wohnen bis lernen.", {"itens": [{"id": "it003"}], "narrativa": false}], ["Las", "Denken Meer Sonntag gefährlich.", {"itens": [{"id": "it018"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it006"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}