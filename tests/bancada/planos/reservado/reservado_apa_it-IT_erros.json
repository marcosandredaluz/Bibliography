 11, 12]]}}, {"id": "extra0", "type": "book", "title": "Mantenere musica sognare rapporto professore bocca punto possibilità insieme dividere", "language": "it_IT", "issued": {"date-parts": [[2004]]}, "author": [{"family": "Rosselli-Piacentini", "given": "Dario"}, {"family": "Berengario", "given": "Margherita"}], "publisher": "Malacarne, Bombieri e Paruta e figli", "publisher-place": "Badile"}, {"id": "extra1", "type": "chapter", "title": "Muro merito attorno staccare risultato moglie", "language": "it_IT", "issued": {"date-parts": [[2023]]}, "author": [{"family": "Pirelli", "given": "Mario", "non-dropping-particle": "dos"}, {"family": "Fogazzaro", "given": "Bartolomeo"}, {"family": "Ferrari", "given": "Hugo"}], "container-title": "Pubblicare rapporto insegnare forse argomento", "publisher": "Pirandello, Leopardi e Visintini s.r.l.", "publisher-place": "Pianzano", "editor": [{"family": "Cimini", "given": "Gianfrancesco"}], "page": "192-207"}], "paragrafos": [[{"texto": "Ampio vista né titolo.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}, {"texto": "Cielo gioia spiegare venire volare quello unico.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Mangiare conoscere sorella riportare qualunque origine governo film. Dolce grosso calcio.", "citacao": {"itens": [{"id": "it018"}, {"id": "it000"}, {"id": "it008"}], "narrativa": false}}], [{"texto": "Molto assicurare disposizione perfino prodotto superiore bambina. Immaginare senza amare loro valere speranza.", "citacao": null}, {"texto": "Albero si vendere.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Azione ragazza romano durante esercito momento luna. Segretario cavallo fissare celebrare quale valore prendere porta.", "citacao": null}, {"texto": "Pezzo notare matrimonio età. Spegnere figlio pianta cristiano. Mettere contento stare presentare proporre amore estero.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Voi fumare oro camera accettare almeno amare esame. Angolo ultimo silenzio cambiare giocare ospedale ogni nord.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Piazza nemmeno organizzare. Stanco base mostrare.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Forza qualche storia argomento mancare donna. Avvertire modo denaro crescere porta ultimo.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}, {"texto": "Guerra attendere resto moderno mattino animale.", "citacao": {"itens": [{"id": "it025"}, {"id": "it002"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Ritornare famiglia certamente discorso.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Ordinare sorridere sognare toccare. Bisognare armare istituto sapere villa tra. Mente opera pelle cantare parlare ferire presidente. Materia dimenticare opinione elemento ministro tuo appunto.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Salutare isola uccidere discutere reale. Romano eh colpo sapere compagno chi cadere.", "citacao": {"itens": [{"id": "it021"}], "narrativa": true}}, {"texto": "Croce iniziare finestra cavallo gesto contare coraggio.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Ampio attività normale porre giustizia voi bellezza. Brutto proprio noi disporre possibile ritenere dirigere. Forte rivolgere usare appoggiare. Aspetto tratto inizio comporre lotta.", "citacao": {"itens": [{"id": "it024"}, {"id": "it022"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Successo niente nobile diverso costituire quadro estendere certamente. Energia studio amico libero. Campo durante silenzio regno.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Spalla cattivo attendere sbagliare grave giovane finire creare.", "citacao": null}, {"texto": "Crisi rivoluzione riempire.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Di colpire croce rivoluzione scopo avvocato essa. Piccolo potenza ordine rivoluzione difesa.", "citacao": {"itens": [{"id": "it014"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Limite segreto peso ricerca dimostrare.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}, {"texto": "Esprimere estero domani via attaccare internazionale.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Andare ora accompagnare attraversare idea ringraziare scuola gesto. Forma finestra università destino piuttosto mio. Zitto donna ne capitare.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Desiderio liberare metà assai capello.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Nessuno giovanotto fresco aumentare autorità. Ricerca eccetera calcio esperienza.", "citacao": {"itens": [{"id": "it017"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Minore giro rimettere scuola ordinare come speciale antico. Dottore angolo signora rendere estate. Vincere segnare prendere vi gridare settimana prevedere.", "citacao": null}], [{"texto": "Città felice durare là piantare.", "citacao": {"itens": [{"id": "it007"}], "narrativa": true}}, {"texto": "Peso secolo niente armare dormire. Circa lavorare contro vero discutere riferire pranzo.", "citacao": null}], [{"texto": "Bocca problema bisognare decisione affrontare riprendere.", "citacao": null}, {"texto": "Posare nulla piacere mettere vecchio scusare pregare questione.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Abito chiamare sole.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Udire merito società necessità pomeriggio pena contare fantasia. Risolvere soluzione concludere governo grande via capire.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Salvare città preferire non situazione. Allontanare uso ricordare metro voi.", "citacao": {"itens": [{"id": "it001"}, {"id": "it017"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Vostro volere loro ora escludere.", "citacao": {"itens": [{"id": "it024"}, {"id": "it017"}], "narrativa": false}}, {"texto": "Verità particolare ritornare finché massa.", "citacao": {"itens": [{"id": "it027"}, {"id": "it026"}], "narrativa": false}}]], "direta": {"texto": "Difesa impedire staccare girare divertire strumento figlio allontanare su forma bello", "citacao": {"itens": [{"id": "it004", "locator": "284", "label": "page"}], "narrativa": false}}, "tabela": [["Tendere", "Studio attenzione elevare giro notevole sogno braccio pranzo.", {"itens": [{"id": "it025"}], "narrativa": false}], ["Semplice", "Nazione godere dopo cantare ferire aiuto.", {"itens": [{"id": "it021"}], "narrativa": false}], ["Pericoloso", "Correre recare chissà inoltre.", {"itens": [{"id": "it010"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it026"}], "narrativa": true}, "injecoes": {"orfas": ["it020", "it027"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}