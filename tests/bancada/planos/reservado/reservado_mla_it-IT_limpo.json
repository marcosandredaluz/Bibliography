unzione felice riva organizzare", "language": "it_IT", "issued": {"date-parts": [[2022]]}, "author": [{"family": "Gagliardi", "given": "Romolo"}, {"family": "Collodi", "given": "Rosa"}, {"family": "Goldoni", "given": "Agostino"}, {"family": "Brunelleschi", "given": "Donna"}, {"family": "Interminelli", "given": "Gioele"}, {"family": "Speri", "given": "Claudio"}], "container-title": "Epidemiologia e Serviços de Saúde", "volume": "40", "issue": "6", "page": "692-707", "DOI": "10.99999/teste.reservado.18694"}, {"id": "it024", "type": "article-journal", "title": "Pagina brutto togliere diventare usare", "language": "it_IT", "author": [{"family": "Nosiglia", "given": "Elisa"}, {"family": "Cavanna", "given": "Barbara"}, {"family": "Zacco", "given": "Arturo"}, {"family": "Morrocco", "given": "Uberto"}, {"family": "Guidotti", "given": "Carolina"}, {"family": "Cristoforetti", "given": "Liliana"}], "container-title": "Epidemiologia e Serviços de Saúde", "volume": "1", "issue": "5", "page": "15-33", "DOI": "10.99999/teste.reservado.94964"}, {"id": "it025", "type": "article-journal", "title": "Povero paese presentare attenzione rientrare settimana", "language": "it_IT", "issued": {"date-parts": [[2019]]}, "author": [{"family": "Campise", "given": "Giada"}], "container-title": "Revue d'Épidémiologie et de Santé Publique", "volume": "10", "issue": "9", "page": "517-528", "DOI": "10.99999/teste.reservado.34255"}, {"id": "it026", "type": "thesis", "title": "Letto questo viaggio acqua mancare stanza contadino", "language": "it_IT", "issued": {"date-parts": [[2019]]}, "author": [{"family": "Campise", "given": "Giada"}], "publisher": "Lancisi-Zichichi e figli", "publisher-place": "Martinetto Del Rame"}], "paragrafos": [[{"texto": "Finestra fatto proporre indicare soltanto notizia ricco. Fiume pazzo osservare scomparire.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Famoso treno vino appartenere parecchio braccio. Inizio oppure malattia godere. Azzurro tempo assicurare diretto.", "citacao": {"itens": [{"id": "it014"}, {"id": "it024"}, {"id": "it002"}], "narrativa": false}}], [{"texto": "Finalmente passo ragione dito meno spettacolo decisione.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}, {"texto": "Fresco meno caro.", "citacao": null}, {"texto": "Accadere mentre pietà strumento domanda.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Militare avvenire sede macchina.", "citacao": null}], [{"texto": "Porre vestire estremo bruciare.", "citacao": null}, {"texto": "Egli se riempire paese dirigere oramai fianco.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Gente limite dirigere luogo minuto. Festa decisione volontà fresco isola sicuro.", "citacao": {"itens": [{"id": "it013"}, {"id": "it008"}, {"id": "it014"}], "narrativa": false}}, {"texto": "Militare spirito sorella recente.", "citacao": {"itens": [{"id": "it009"}, {"id": "it021"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Caldo lei voce cambiare.", "citacao": {"itens": [{"id": "it016"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Mattino loro infine abito particolare quadro.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Cioè comune comunicazione.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Volto giugno restare leggero volto accogliere. Spesa internazionale labbro domenica. Rivedere pensiero discutere scusare.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Risultato dedicare risposta eppure meno attento.", "citacao": {"itens": [{"id": "it022"}, {"id": "it021"}], "narrativa": false}}], [{"texto": "Bruciare storia età lui giallo. Sentire sorella ombra pranzo. Temere alto commercio eppure basso secondo.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Posizione bambino sacro udire qualche perdere scendere.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Morire là saltare comunicazione fornire società. Contare situazione dentro provare.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Difendere conservare malattia rientrare opera.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Animale serie addosso muovere rispondere qualunque vuoto.", "citacao": {"itens": [{"id": "it024"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Normale principio cittadino stazione.", "citacao": null}], [{"texto": "Stringere corpo abbastanza.", "citacao": null}, {"texto": "Importanza e sorridere proposito lo ognuno rapporto.", "citacao": {"itens": [{"id": "it016"}, {"id": "it015"}, {"id": "it010"}], "narrativa": false}}], [{"texto": "Spesa provocare ammazzare chilometro dito concludere uomo utile. Condizione sembrare signorina malattia già ma oltre.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Prossimo eh successo occorrere morire.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Milione silenzio paese permettere serio.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Difficile creare gesto italiano qualcuno bambina. Entrare relazione bisogno lavoro.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}, {"texto": "Storico mi rimanere forse naturale.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Poco idea bisogno leggero.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Contare qualche ecco gridare pensare corso proposito.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Rosso poesia via desiderare dottore vero assistere. Decidere bestia restare qualcosa sorriso scusare buio annunciare. Principe avere valore destino fiore intenzione ammazzare.", "citacao": {"itens": [{"id": "it010"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Adesso giocare moglie tavola roba caro ombra ambiente.", "citacao": {"itens": [{"id": "it018"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Famoso speciale ordine il presto tuttavia seguito ordinare. Riconoscere recare ricevere dottore. Qua annunciare tratto amico attaccare.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Ricordare risposta staccare conservare scuola quadro. Resto atteggiamento aprire riprendere dare salvare.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Spiegare sorella mancare dipendere giugno spesso.", "citacao": {"itens": [{"id": "it015"}, {"id": "it002"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Ognuno destro seguire soluzione voce prima piantare.", "citacao": {"itens": [{"id": "it009"}, {"id": "it022"}, {"id": "it011"}], "narrativa": false}}, {"texto": "Vendere posto cominciare legge madre bisogno.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Non qualche appoggiare.", "citacao": null}, {"texto": "Rompere eccetera atteggiamento elettrico causa.", "citacao": {"itens": [{"id": "it026"}, {"id": "it015"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Morale proporre lotta minore guerra largo.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}]], "direta": {"texto": "Straordinario automobile muro braccio indicare aprire argomento normale legare altro", "citacao": {"itens": [{"id": "it024", "locator": "280", "label": "page"}], "narrativa": false}}, "tabela": [["Temere", "Appartenere pure bastare fretta nascere.", {"itens": [{"id": "it004"}], "narrativa": false}], ["Carne", "Valle succedere a io cucina.", {"itens": [{"id": "it009"}], "narrativa": false}], ["Leggero", "Tavola musica base o continuare scena.", {"itens": [{"id": "it018"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it002"}], "narrativa": false}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}