iven": "Cilly"}], "container-title": "One Health", "volume": "12", "issue": "3", "page": "118-133", "DOI": "10.99999/teste.reservado.16948"}, {"id": "it032", "type": "thesis", "title": "Gesund gefährlich nass Boden schön packen hier", "language": "de_DE", "issued": {"date-parts": [[2007]]}, "author": [{"family": "Rogge", "given": "Dagobert"}, {"family": "Kühnert", "given": "Stanislaus"}], "publisher": "Schacht KG", "publisher-place": "Neubrandenburg"}, {"id": "it033", "type": "article-journal", "title": "Klasse endlich also packen Baum springen Angst", "language": "de_DE", "issued": {"date-parts": [[2007]]}, "author": [{"family": "Rogge", "given": "Dagobert"}, {"family": "Kühnert", "given": "Stanislaus"}], "container-title": "Das Gesundheitswesen", "volume": "1", "issue": "10", "page": "192-210", "DOI": "10.99999/teste.reservado.27545"}, {"id": "extra0", "type": "article-journal", "title": "Schwester schicken Freude nimmt es Vogel schwer auf neben die Berg hier", "language": "de_DE", "issued": {"date-parts": [[2018]]}, "author": [{"family": "Hornich-Cichorius", "given": "Rahel"}, {"family": "Thies", "given": "Anto"}, {"family": "Krein", "given": "Anneli"}], "container-title": "Gaceta Sanitaria", "volume": "75", "issue": "6", "page": "9-27", "DOI": "10.99999/teste.reservado.59030"}, {"id": "extra1", "type": "legislation", "title": "Denn Weg bald denken Lehrer", "language": "de_DE", "issued": {"date-parts": [[2007]]}, "author": [{"family": "Gnatz", "given": "Albina", "non-dropping-particle": "del"}], "number": "13902", "URL": "https://leis-reservado.gov/6777"}], "paragrafos": [[{"texto": "Schlafen las sonst freuen müde dein.", "citacao": null}, {"texto": "Neben sagen fahren.", "citacao": {"itens": [{"id": "it032"}, {"id": "it029"}], "narrativa": false}}, {"texto": "Ließ sie will waschen Tante lustig Lehrerin.", "citacao": null}], [{"texto": "Schwer kurz dumm. Geld richtig kaufen unten. Die sollen draußen lesen weinen halbe.", "citacao": null}], [{"texto": "Stein Sommer fressen Fisch.", "citacao": {"itens": [{"id": "it030"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Mama rechnen böse Stadt. Affe Jahr merken Freude.", "citacao": null}, {"texto": "Andere Frage kennen finden schwarz sieben Berg sprechen.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}], [{"texto": "Nun Wald bringen gleich will nach. Vergessen Feuer darauf weil genau.", "citacao": {"itens": [{"id": "it004"}, {"id": "it011"}], "narrativa": false}}], [{"texto": "Kaufen sieben am gehen schon lieb.", "citacao": {"itens": [{"id": "it024"}], "narrativa": true}}, {"texto": "Jetzt Boden neun den führen sieht Haus rennen.", "citacao": {"itens": [{"id": "it010"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Ein Wald antworten steigen klein schlagen.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Monat dich Fisch tun.", "citacao": null}, {"texto": "Auf Fahrrad lernen lustig Bild ins sehen fünf. Können reiten Arzt.", "citacao": null}, {"texto": "Weg Fisch las Katze.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Kennen schnell waschen Hunger möglich.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Bild Flasche Erde einigen schlagen richtig.", "citacao": null}], [{"texto": "Groß Name eigentlich. Familie nicht suchen Sommer Wort. Setzen Welt fertig.", "citacao": {"itens": [{"id": "it029"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Baum weg vergessen als Stück können doch Geschenk.", "citacao": {"itens": [{"id": "it009"}, {"id": "it028"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Stein Bruder danach Loch dann jeder danach sehen. Lieb Ende Sohn Auge Bauer.", "citacao": {"itens": [{"id": "it000"}, {"id": "it028"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Öffnen selbst las bei waschen fertig an waschen.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}, {"texto": "Er Eis Brot Boden fährt merken.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}], [{"texto": "Wir dumm davon lustig Sonntag Ding. Gelb wirklich darauf.", "citacao": {"itens": [{"id": "it031"}, {"id": "it015"}, {"id": "it011"}], "narrativa": false}}], [{"texto": "Gibt wo heraus an heißen möglich schaffen später.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Leben nach schwer Sonne dafür dir denn.", "citacao": {"itens": [{"id": "it033"}], "narrativa": false}}, {"texto": "Tag Buch sicher beim klettern.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Schauen tun haben waschen zehn gefährlich.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Sind Bruder laufen Nase sein.", "citacao": {"itens": [{"id": "it013"}, {"id": "it021"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Katze Loch Arbeit helfen Sohn schön erst.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Ruhig los müssen wir mit sind.", "citacao": null}, {"texto": "Dann Musik schlecht nimmt Name wünschen.", "citacao": {"itens": [{"id": "it002"}, {"id": "it025"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Schnell richtig Kind mich. Antworten stellen ins dein im einmal auch Boden.", "citacao": {"itens": [{"id": "it002"}], "narrativa": true}}], [{"texto": "Dein Erde langsam spielen denn Hund dumm kochen. Gab werden merken gesund fiel. Denn hängen sich Bett.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Ende Tante davon immer Kopf Nacht Zeitung Hand.", "citacao": {"itens": [{"id": "it010"}, {"id": "it030"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Singen Name Hase. Plötzlich kurz baden kennen Luft. Gut nehmen nichts wo geben Baum. Hund also heraus Leben.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Sein Wohnung fliegen sagen seit.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Dann wichtig hier nun Loch Monate. Vielleicht vorbei haben da.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Sonne wer baden ob anfangen. Hinter leben einmal reich Gott voll.", "citacao": null}, {"texto": "Nennen vier Buch Flasche.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Fehlen Eltern Bett kalt Berg Zeitung will.", "citacao": {"itens": [{"id": "it000"}], "narrativa": true}}], [{"texto": "Vom gefährlich ob nennen davon. Schnee nein nimmt. Ließ durch Sache sind fertig lachen.", "citacao": {"itens": [{"id": "it032"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Schwarz Wagen beide zwischen Winter steigen den Herz.", "citacao": {"itens": [{"id": "it004"}, {"id": "it028"}, {"id": "it017"}], "narrativa": false}}], [{"texto": "Schwarz viel lieb nehmen Winter Feuer richtig. Fuß Geschichte Arbeit Monate Wagen am gerade fertig.", "citacao": {"itens": [{"id": "it022"}], "narrativa": true}}, {"texto": "Familie lieb Maus Stadt böse ob.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Glas auf Stadt alt Fahrrad plötzlich Oma Zimmer.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}], [{"texto": "Freuen Blume fröhlich offen verstehen hin.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Böse dann Blume traurig nur einige Familie am. Endlich oben wirklich Spiel dauern deshalb bei.", "citacao": {"itens": [{"id": "it020"}], "narrativa": true}}, {"texto": "Oft hier Nase ihr Hase.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Fährt bin neben acht schön. Schlimm ohne vielleicht bekommen es deshalb. Weg Junge Mensch wollen.", "citacao": null}, {"texto": "Nicht Ferien zur Wald springen schwer. Bin Wohnung unser gegen neun.", "citacao": {"itens": [{"id": "it003"}, {"id": "it029"}, {"id": "it016"}], "narrativa": false}}, {"texto": "Dick Wasser gleich früh vom überall. Mich gehen kurz. Wald hat Straße fünf denn Himmel Arbeit.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}]], "direta": {"texto": "Vom gar treffen klettern Welt leben Fenster letzte sitzen hinein Klasse erst der", "citacao": {"itens": [{"id": "it015", "locator": "103", "label": "page"}], "narrativa": false}}, "tabela": [["Hase", "Reiten vom sollen Name wollen will zusammen essen.", {"itens": [{"id": "it008"}], "narrativa": false}], ["Schiff", "Werfen hören Wort wie.", {"itens": [{"id": "it014"}], "narrativa": false}], ["Dunkel", "Wo werfen haben fiel Abend Vater hängen.", {"itens": [{"id": "it014"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it027"}], "narrativa": true}, "injecoes": {"orfas": ["it027", "it028"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}