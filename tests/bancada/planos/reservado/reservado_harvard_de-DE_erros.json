servado.org/5565", "accessed": {"date-parts": [[2026, 11, 2]]}}, {"id": "extra0", "type": "article-journal", "title": "Schenken zu besser selbst Gott Ball Loch", "language": "de_DE", "issued": {"date-parts": [[2024]]}, "author": [{"family": "Stumpf-Heuser", "given": "Claire"}], "container-title": "Gaceta Sanitaria", "volume": "34", "issue": "2", "page": "294-310"}, {"id": "extra1", "type": "legislation", "title": "Hilfe unten einmal blau für reiten Weihnachten genau wir Bruder essen Monat", "language": "de_DE", "issued": {"date-parts": [[2015]]}, "author": [{"family": "Johann", "given": "Walfried", "non-dropping-particle": "del"}, {"family": "Schacht", "given": "Eugenia"}, {"family": "Rohleder", "given": "Arthur"}, {"family": "Martin", "given": "Heinz-Günther"}], "number": "5146", "URL": "https://leis-reservado.gov/4753"}], "paragrafos": [[{"texto": "Tot lachen ab Sohn Finger weg.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Dann Zug frei vor für zusammen heraus. Plötzlich zurück oder selbst legen Vogel fast.", "citacao": {"itens": [{"id": "it022"}, {"id": "it031"}, {"id": "it004"}], "narrativa": false}}, {"texto": "Setzen fragen sehr verkaufen Blume laut. Laufen dafür ins vor. Zeigen erzählen sich Fußball wohl neu grün.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Nächste merken gesund dem Nacht nun Ding Bett.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Kann lange ihm trinken.", "citacao": null}, {"texto": "Oben gefährlich früher versuchen schwarz wenn immer.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Plötzlich Monat Weg öffnen auch.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Hand führen fast.", "citacao": {"itens": [{"id": "it005"}, {"id": "it026"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Freund Bild Bett man tot hinter offen.", "citacao": {"itens": [{"id": "it004"}], "narrativa": true}}], [{"texto": "Gerade sitzen haben Wald.", "citacao": {"itens": [{"id": "it015"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Zug schlecht später.", "citacao": null}, {"texto": "Mensch zur Abend antworten etwas mal wichtig.", "citacao": {"itens": [{"id": "it012"}, {"id": "it018"}, {"id": "it016"}], "narrativa": false}}], [{"texto": "Viel um gehen lieb deshalb setzen. Ball fiel Uhr.", "citacao": {"itens": [{"id": "it018"}, {"id": "it030"}], "narrativa": false}}, {"texto": "Kind war rund.", "citacao": {"itens": [{"id": "it002"}, {"id": "it015"}], "narrativa": false}}], [{"texto": "Baum auf spät lustig Fußball Woche. Fressen hart sprechen.", "citacao": null}, {"texto": "Gibt nicht fünf rund halbe schreiben lernen.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Junge warten braun Vogel singen.", "citacao": {"itens": [{"id": "it027"}], "narrativa": false}}], [{"texto": "Die allein Geburtstag erst ihm.", "citacao": {"itens": [{"id": "it011"}], "narrativa": true}}, {"texto": "Wasser leise schlimm erklären kaufen kennen.", "citacao": null}], [{"texto": "Arbeit Geschenk Sonne unten.", "citacao": {"itens": [{"id": "it011"}, {"id": "it017"}], "narrativa": false}}, {"texto": "Wieder Tag Leben. Bett später hoch alt danach dich Jahr.", "citacao": null}, {"texto": "Heiß versuchen erst zum fiel. Nämlich erschrecken finden weg. Fährt fallen ein.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}, {"texto": "Stein Milch fest Kopf nächste Eis blau Platz.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Rad Finger seit.", "citacao": {"itens": [{"id": "it010"}, {"id": "it000"}, {"id": "it028"}], "narrativa": false}}], [{"texto": "Sechs früher doch ziehen stark. Klasse Stadt rennen denken jung. Nämlich Brot Onkel Sache Opa auch fünf.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Nach mögen Kopf heraus kam. Tragen erschrecken ihn drehen verstehen. Sache Spaß heraus einmal Flasche das.", "citacao": {"itens": [{"id": "it002"}, {"id": "it007"}, {"id": "it026"}], "narrativa": false}}, {"texto": "Mensch Monat Hase verkaufen schön Loch.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Ohne der an Weihnachten Geld.", "citacao": null}], [{"texto": "Gewinnen man auch sein essen zeigen springen richtig. Wir holen Eltern Straße Freude Stadt Uhr. Fehlen tief schön.", "citacao": null}, {"texto": "Natürlich denken Name zurück hat.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Schwimmen wünschen suchen hinter schenken.", "citacao": {"itens": [{"id": "it002"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Warm aber Land Garten.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Unten Erde Tisch gesund rufen durch los dir. Bruder Ding kurz seit Gesicht Zimmer Straße.", "citacao": {"itens": [{"id": "it029"}, {"id": "it011"}], "narrativa": false}}], [{"texto": "Dort arbeiten rot Haus ihr der acht.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}, {"texto": "Sein kochen Luft wir Meer Wagen. Will heißen nah. Weinen las nass Sohn.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}, {"texto": "Frei nie Sache Finger neun ihn Straße.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}], [{"texto": "Küche zwischen gern schlecht aus allein denken Stück.", "citacao": null}, {"texto": "Wiese am müssen in sechs. Schicken halbe Küche Seite Fuß gern nehmen. Für treffen laut erzählen denn beide.", "citacao": {"itens": [{"id": "it028"}], "narrativa": true}}, {"texto": "Neun mein fertig wichtig lustig.", "citacao": {"itens": [{"id": "it020"}, {"id": "it028"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Acht will gehen acht weil Wiese ganz.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Vom Oma endlich spät Stadt. Gerade einigen Beispiel bin rufen Stunde Katze.", "citacao": null}, {"texto": "Schlagen heute eigentlich. Tante viel helfen spät. Glas letzte Affe hinein arbeiten oben.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Arbeiten fahren Winter allein mit plötzlich heiß.", "citacao": null}, {"texto": "Herz sagen böse. Wahr dein gar Teller Fuß Zahl.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Essen Tante dazu zwischen nächste bis.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}, {"texto": "Genau verstehen hoch Essen wirklich.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}], [{"texto": "Das Hase beißen zum. Haare dabei leicht Wohnung Wissen.", "citacao": null}], [{"texto": "Wo nah wissen schlecht schön.", "citacao": null}], [{"texto": "Stark Mann zur Abend fressen dauern.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}, {"texto": "Suchen jung Geld unter schlafen. Vom wissen auch und Lehrerin denn. Dein Musik also.", "citacao": null}, {"texto": "Stunde Woche für letzte. An vorbei endlich rechnen durch Nase groß.", "citacao": null}, {"texto": "Ging erzählen Maus oder.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Schuh er genau waschen ihn machen. Dann fast ihm bekommen.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Weinen fressen Bauer dumm Sommer.", "citacao": null}]], "direta": {"texto": "Alt hin Fisch Garten fröhlich oft fest als glauben plötzlich wieder her Freude wollen suchen", "citacao": {"itens": [{"id": "it023", "locator": "164", "label": "page"}], "narrativa": false}}, "tabela": [["Nach", "Einfach jetzt Tier kaufen.", {"itens": [{"id": "it001"}], "narrativa": false}], ["Schlecht", "Laufen trinken einige Name gar.", {"itens": [{"id": "it029"}], "narrativa": false}], ["Brauchen", "Lachen zwei Abend Abend Zimmer drei.", {"itens": [{"id": "it027"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it026"}], "narrativa": true}, "injecoes": {"orfas": ["it014", "it030"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": 