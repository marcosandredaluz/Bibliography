or": [{"literal": "Secretaria Municipal da Saúde (Curitiba)"}], "number": "13463", "URL": "https://leis-reservado.gov/4751"}, {"id": "it022", "type": "article-journal", "title": "Dick sprechen in nie nein kann", "language": "de_DE", "author": [{"family": "Matthäi", "given": "Aleksander"}, {"family": "Schleich", "given": "Grete"}, {"family": "Hübel", "given": "Gabriele"}], "container-title": "Revue d'Épidémiologie et de Santé Publique", "volume": "62", "issue": "3", "page": "793-800", "DOI": "10.99999/teste.reservado.65992"}, {"id": "it023", "type": "report", "title": "Natürlich auf letzte will Hase plötzlich gern trinken", "language": "de_DE", "issued": {"date-parts": [[2005]]}, "author": [{"literal": "Agência Nacional de Vigilância Sanitária (Brasil)"}], "publisher": "Davids Kaul KGaA", "publisher-place": "Niesky"}, {"id": "it024", "type": "legislation", "title": "Letzte heiß baden dumm Geld bald setzen Nase", "language": "de_DE", "issued": {"date-parts": [[2005]]}, "author": [{"literal": "Agência Nacional de Vigilância Sanitária (Brasil)"}], "number": "2015", "URL": "https://leis-reservado.gov/420"}, {"id": "extra0", "type": "article-journal", "title": "Leben sein Hund Mutter", "language": "de_DE", "issued": {"date-parts": [[1992]]}, "author": [{"family": "Heinrich-Gunpf", "given": "Mirjam"}], "container-title": "Journal of the American Medical Informatics Association", "volume": "50", "issue": "3", "page": "870-877", "DOI": "10.99999/teste.reservado.89463"}, {"id": "extra1", "type": "webpage", "title": "Dich warten Bauer fragen verstecken Bruder Bein wohl Loch für", "language": "de_DE", "issued": {"date-parts": [[1986]]}, "author": [{"family": "Schlosser", "given": "Songül", "non-dropping-particle": "von"}], "URL": "https://exemplo-reservado.org/5855", "accessed": {"date-parts": [[2026, 11, 9]]}}], "paragrafos": [[{"texto": "Durch sehen ab Fuß warten Oma fröhlich.", "citacao": {"itens": [{"id": "it008"}], "narrativa": true}}], [{"texto": "Neun Sonne warum Monate. Schlagen Tür es später müde las früh. Leben hoch hin sie hoch.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Straße einfach Wasser immer traurig merken. Sein Mama Wetter helfen ab.", "citacao": {"itens": [{"id": "it017"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Fuß Wissen sonst.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}, {"texto": "Gegen sonst lassen ins stellen.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Lachen Geschichte ohne rund.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Überall Teller gegen den dauern Mutter vorbei.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Heraus eigentlich Haus Tante.", "citacao": null}], [{"texto": "Nie viel antworten wenig sehen ja alt. Fußball Angst aus. Ball Meer Frage Polizei zum Klasse gerade. Kommen geben dumm.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}, {"texto": "Vater im fertig Schluss etwas.", "citacao": {"itens": [{"id": "it024"}], "narrativa": true}}], [{"texto": "Lieb Gesicht jetzt schlagen Freund scheinen.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Schön plötzlich offen damit neu Teller. Oben Fußball Gesicht Geld Stunde davon tun.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Aus darauf als dann ab klettern. Lange uns fahren wenig. Weg die Milch einigen anfangen acht. Liegen Stelle gut Mädchen frei weg der.", "citacao": {"itens": [{"id": "it017"}, {"id": "it023"}], "narrativa": false}}, {"texto": "Kochen setzen Angst Platz überall drehen.", "citacao": {"itens": [{"id": "it006"}, {"id": "it007"}, {"id": "it016"}], "narrativa": false}}, {"texto": "Tier grün Essen werden schenken.", "citacao": {"itens": [{"id": "it021"}, {"id": "it014"}], "narrativa": false}}], [{"texto": "Nie hinter beißen Onkel. Gar es Boden Fußball.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}], [{"texto": "Nennen der Welt lachen kalt.", "citacao": null}], [{"texto": "Gerade selbst es zusammen später Monat.", "citacao": {"itens": [{"id": "it008"}], "narrativa": false}}, {"texto": "Erschrecken Sonne auf. Hören Wald können Musik erschrecken. Vater aus mich lieb weil langsam.", "citacao": null}, {"texto": "Neu Blume wie man gelb Apfel Winter fahren. Gibt werden gehen Affe jetzt Welt gelb.", "citacao": {"itens": [{"id": "it006"}], "narrativa": true}}], [{"texto": "Klein fast jetzt arbeiten Freund die.", "citacao": {"itens": [{"id": "it014"}, {"id": "it024"}], "narrativa": false}}, {"texto": "Sicher Mann wer hat.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}], [{"texto": "Unter Bett neun Spaß sind oder. Bin dabei gestern sehen nur zeigen er.", "citacao": {"itens": [{"id": "it012"}, {"id": "it003"}, {"id": "it002"}], "narrativa": false}}, {"texto": "Hinter mögen ziehen Fußball sicher neben.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Monate Land zehn mit dauern.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Arzt Licht unten helfen Brief Abend wieder. Wenig Pferd will baden Land.", "citacao": null}], [{"texto": "Sicher hören Monate eigentlich Himmel.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Setzen tot Spiel nächste.", "citacao": {"itens": [{"id": "it022"}, {"id": "it024"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Früh dir weg hören antworten glauben Frage denken.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Möglich warten jetzt ihn sitzen so doch.", "citacao": {"itens": [{"id": "it012"}], "narrativa": true}}, {"texto": "Freuen oft schenken ruhig Zahl tot wirklich. Versuchen dafür fiel führen drehen reiten sieben tragen.", "citacao": null}], [{"texto": "Dazu Geschichte im Auto weil.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Drei leben mal. Sehen den machen genau Stunde acht Mutter tot. Denn draußen dein dein Eis.", "citacao": {"itens": [{"id": "it009"}], "narrativa": true}}, {"texto": "Also Mutter laut Junge See tief ich beide. Nun um müde.", "citacao": null}, {"texto": "Nase los Hase brauchen. Zwischen mögen Essen jung las allein Ende.", "citacao": null}], [{"texto": "Bis sprechen trinken Geschenk selbst.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Monat Fisch fallen Mädchen wie daran. Kam über Spaß vielleicht Oma unten ziehen. Garten zum von genau Bauer bauen wie Abend.", "citacao": {"itens": [{"id": "it023"}, {"id": "it010"}], "narrativa": false}}]], "direta": {"texto": "Lange gut langsam Buch laufen und Bild hören Fahrrad Stück dauern holen", "citacao": {"itens": [{"id": "it019", "locator": "45", "label": "page"}], "narrativa": false}}, "tabela": [["Fisch", "Land für sieben dazu bekommen sprechen damit singen.", {"itens": [{"id": "it024"}], "narrativa": false}], ["Müde", "Dort zwei dazu treffen klettern Baum beide Wasser.", {"itens": [{"id": "it013"}], "narrativa": false}], ["Blume", "Verkaufen Feuer Schiff.", {"itens": [{"id": "it001"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it004"}], "narrativa": true}, "injecoes": {"orfas": ["it000", "it021"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}