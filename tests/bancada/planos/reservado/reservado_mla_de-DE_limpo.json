o": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Tun Feuer ihn mögen Essen gehen kam her. Neben Mädchen warten sehr. Rot wissen nah.", "citacao": {"itens": [{"id": "it012"}, {"id": "it017"}], "narrativa": false}}, {"texto": "Weinen stehen Brot Mensch verkaufen rund groß rufen.", "citacao": {"itens": [{"id": "it017"}, {"id": "it009"}, {"id": "it015"}], "narrativa": false}}], [{"texto": "Wohnung Wort nach zur. Brot andere Land arbeiten mein Haare erklären Wiese. Kalt wer lieb holen.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Doch dein Luft zeigen braun gerade. Mögen Feuer spielen dauern Bauer schlimm. Bauer Sonne gleich im fehlen.", "citacao": null}, {"texto": "Tür Bruder Mama zehn Spaß hin Stadt heiß. Gleich mit Geld setzen nimmt.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Ja Kopf Monate dir nah so warum Bauer.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Richtig einigen schnell wie Apfel das gegen Musik. Stellen nein besser schnell an neun. Spaß nicht kann sechs in Fenster Musik Vater.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Auch las ihr wenig stellen Weg hat. Die hier auf Wohnung rechnen lange kommen.", "citacao": null}, {"texto": "Reiten legen nicht müssen reiten.", "citacao": {"itens": [{"id": "it028"}], "narrativa": false}}], [{"texto": "Bein hin sehen hängen hinein. Schnell auf denn turnen Glück zurück lange. Land noch hier mal Wagen. Ihm dürfen schwer gegen dunkel schauen Ferien.", "citacao": null}, {"texto": "Davon hin sofort gelb Wohnung wenig Stunde tragen.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Schuh Musik bin es vom finden. Schaffen gestern noch hin gegen Zimmer. Eigentlich Arbeit zur Land.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Seite Welt dunkel weiß Fuß Haus lachen.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}]], "dir