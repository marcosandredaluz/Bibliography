"id": "it024", "type": "legislation", "title": "Impedire costringere forte creare arte avvertire porta presente maniera", "language": "it_IT", "author": [{"literal": "Public Health Agency of Canada"}], "number": "10201", "URL": "https://leis-reservado.gov/3100"}, {"id": "it025", "type": "legislation", "title": "Inoltre passione facile avvocato dormire latino no stagione campagna", "language": "it_IT", "issued": {"date-parts": [[1976]]}, "author": [{"family": "Sauro", "given": "Ludovico"}, {"family": "Bulzoni", "given": "Antonino"}, {"family": "Antelami", "given": "Morena"}], "number": "264", "URL": "https://leis-reservado.gov/319"}, {"id": "it026", "type": "book", "title": "Sorprendere attorno ritornare mente linea salire coraggio ciò", "language": "it_IT", "issued": {"date-parts": [[1976]]}, "author": [{"family": "Sauro", "given": "Ludovico"}, {"family": "Bulzoni", "given": "Antonino"}, {"family": "Antelami", "given": "Morena"}], "publisher": "Mercantini Group", "publisher-place": "Castel San Pietro Romano"}, {"id": "extra0", "type": "report", "title": "Bisognare capitare esercito tentare apparire provvedere svegliare pubblicare", "language": "it_IT", "issued": {"date-parts": [[1987]]}, "author": [{"family": "Zichichi-Bombieri", "given": "Ruggero"}], "publisher": "Ruberto Group", "publisher-place": "Salutio"}, {"id": "extra1", "type": "article-journal", "title": "Differenza davanti cui sperare lei don buttare", "language": "it_IT", "issued": {"date-parts": [[2006]]}, "author": [{"family": "Medici", "given": "Maria", "non-dropping-particle": "van der"}, {"family": "Gargallo", "given": "Pellegrino"}, {"family": "Costanzi", "given": "Sole"}], "container-title": "Gaceta Sanitaria", "volume": "35", "issue": "11", "page": "404-417", "DOI": "10.99999/teste.reservado.89687"}], "paragrafos": [[{"texto": "Dolore tecnico letto distruggere luna consiglio.", "citacao": {"itens": [{"id": "it025"}], "narrativa": true}}], [{"texto": "Movimento ampio raccontare distanza. Salire nave evitare.", "citacao": {"itens": [{"id": "it000"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Centrale avanti risultato lira sentire. Compiere dove quarto questo produrre numero fenomeno ah.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Aggiungere attaccare naturalmente grande significare sostenere.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Merito azzurro azzurro. Contatto sentimento oltre quale assumere. Interesse merito motivo piangere pensiero ringraziare. Erba io funzione su leggero opera sicurezza bianco.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Gamba sicurezza rivelare sacrificio giallo.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}, {"texto": "Dormire figurare uguale guardia battere spalla civiltà.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Guerra orecchio regno don chiamare storico vivere.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}], [{"texto": "Quanto ponte potere assicurare.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}, {"texto": "Contrario nome quale.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Male lira programma futuro quello raggiungere. Non ferro stazione oggetto.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Io russo macchina sole interno. Pericoloso innamorare sotto tentare straniero.", "citacao": {"itens": [{"id": "it007"}, {"id": "it009"}, {"id": "it023"}], "narrativa": false}}], [{"texto": "Grosso pericoloso richiedere cioè regno vita.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Grazia principe provare ottenere fiore diffondere.", "citacao": null}, {"texto": "Piede relazione quadro dedicare comune ambiente.", "citacao": {"itens": [{"id": "it018"}, {"id": "it005"}], "narrativa": false}}], [{"texto": "Bene costa là conoscenza.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Pazzo divertire zona gioco scusare forza segretario.", "citacao": {"itens": [{"id": "it004"}], "narrativa": true}}], [{"texto": "Carta lavorare vita. Questione signora ci fra attimo ora. Disposizione poesia chiamare stamattina creare difendere.", "citacao": {"itens": [{"id": "it004"}], "narrativa": true}}, {"texto": "Pelle diverso compiere finestra completamente. Intendere avanzare giovanotto giustizia. Entrare peggio inoltre filo campagna. Comodo contare internazionale corrente.", "citacao": null}], [{"texto": "Vecchio privato conoscenza lo no. Famiglia storico soprattutto solo difesa partecipare.", "citacao": null}, {"texto": "Seguito primo forse guardia fresco.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}], [{"texto": "Elemento profondo vecchio tono destro dubbio.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}, {"texto": "Completamente militare moderno mostrare sposare.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Religioso mestiere andare differenza tornare profondo mentre presentare. Differenza qui situazione pensiero eccellenza comodo chi.", "citacao": null}], [{"texto": "Dipendere ricordare stare corrente stagione. Trasformare infatti determinare avvocato prato legare tra.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Animale dubbio russo. Pagina immaginare ufficiale cadere. Perciò da odore lui.", "citacao": {"itens": [{"id": "it006"}, {"id": "it002"}], "narrativa": false}}, {"texto": "Sole direzione osservare sino essa niente.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}, {"texto": "Controllo magari confronto leggere passare.", "citacao": {"itens": [{"id": "it024"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Dimenticare interno ci avere automobile ragazzo.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}], [{"texto": "Terreno intenzione tutto leggere latino vivo.", "citacao": {"itens": [{"id": "it009"}, {"id": "it005"}, {"id": "it013"}], "narrativa": false}}], [{"texto": "Costituire industriale principale senso visita orecchio scusare. Collo preciso situazione giovane io avere.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}, {"texto": "Dire sentire vasto umano normale passione fino. Sorgere felice civile solito. Accadere recente contrario.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Impedire sinistro regno grande tuo vestire. Eh finché libertà militare ci.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Perciò foglia leggere. Neppure letto libertà sangue proposta mano corsa labbro.", "citacao": {"itens": [{"id": "it024"}, {"id": "it008"}, {"id": "it004"}], "narrativa": false}}], [{"texto": "Cane preparare don piano frutto credere lo soluzione.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Udire maniera guerra attenzione rifiutare contento il. Insegnare accogliere probabilmente destino abbastanza.", "citacao": {"itens": [{"id": "it002"}, {"id": "it000"}, {"id": "it021"}], "narrativa": false}}]], "direta": {"texto": "Parecchio arrivare prezzo freddo ricevere vicino attento battaglia salutare creare dedicare dottore trattare dormire", "citacao": {"itens": [{"id": "it026", "locator": "213", "label": "page"}], "narrativa": false}}, "tabela": [["Silenzio", "Notizia piangere antico atto.", {"itens": [{"id": "it010"}], "narrativa": false}], ["Eh", "Cattolico gente stanco cortile.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Conservare", "Anzi ringraziare espressione cielo aspettare piantare indietro persona.", {"itens": [{"id": "it013"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it010"}], "narrativa": true}, "injecoes": {"orfas": ["it019", "it023"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}