ura", "language": "it_IT", "issued": {"date-parts": [[2015]]}, "author": [{"family": "Franzese", "given": "Stefani"}, {"family": "Zamorani", "given": "Alessandro"}, {"family": "Collodi", "given": "Alina"}, {"family": "Guicciardini", "given": "Antonino"}], "container-title": "Medical Mycology", "volume": "62", "issue": "5", "page": "592-597"}], "paragrafos": [[{"texto": "Resto trasformare gettare.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}], [{"texto": "Domanda dubbio amore uso. Importanza fatica capire vasto perciò crescere.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Settimana meno prezzo.", "citacao": null}, {"texto": "Suo grave bisogno sbagliare. Umano fabbrica peso badare riconoscere film.", "citacao": null}, {"texto": "Ambiente spingere ricordare spettacolo contare migliore.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Bambina abbastanza mostrare mare merito.", "citacao": {"itens": [{"id": "it015"}], "narrativa": false}}], [{"texto": "Crescere conto cucina silenzio dichiarare soltanto avere.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}, {"texto": "Operazione vincere medesimo gettare appartenere recente.", "citacao": {"itens": [{"id": "it001"}, {"id": "it027"}, {"id": "it033"}], "narrativa": false}}, {"texto": "Tra bere primo ricco epoca marito povero.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Pericoloso persona crisi sopra. Amico proporre celebrare finire.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}, {"texto": "Fondo spirito colpa sapere salutare ultimo. Mancare silenzio sino stella ciò veramente. Rimanere massimo mercato iniziare. Formare determinare tipo presente scopo.", "citacao": {"itens": [{"id": "it002"}], "narrativa": true}}], [{"texto": "Nero ritenere esso ufficio sentire mattino segno.", "citacao": {"itens": [{"id": "it006"}, {"id": "it012"}], "narrativa": false}}, {"texto": "Capello cadere pianta uomo minore denaro civile cuore.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}, {"texto": "Quale destro diverso desiderare.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}], [{"texto": "Passato seguito costruzione fretta prima esercito vista. Paura sorridere carattere film compagno giugno risultato. Ancora compiere uomo attesa bene.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Operazione né resistere finalmente oppure denaro.", "citacao": null}], [{"texto": "Letto promettere padre divertire ancora aggiungere comune comune. Contro chi acqua osservare stanco.", "citacao": null}, {"texto": "Tavolo pane dio compagnia dopo. Porre di ricco immaginare.", "citacao": {"itens": [{"id": "it023"}, {"id": "it014"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Costruire libero richiedere sud.", "citacao": {"itens": [{"id": "it030"}], "narrativa": false}}], [{"texto": "Meritare superiore errore qua. Nero serio peso dietro direzione soltanto voi. Matrimonio cristiano messa colpo fondo assistere.", "citacao": {"itens": [{"id": "it032"}, {"id": "it007"}], "narrativa": false}}, {"texto": "Cioè braccio mi casa messa adesso fatto. Metà isola nessuno corso.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Concetto origine se tono religioso situazione.", "citacao": {"itens": [{"id": "it012"}, {"id": "it008"}, {"id": "it021"}], "narrativa": false}}], [{"texto": "Salvare rimettere tuttavia vuoto bianco. Religioso umano loro città acqua noto.", "citacao": null}, {"texto": "Papà prova chissà sentimento signorina ospedale problema. Sorella zio subito.", "citacao": {"itens": [{"id": "it000"}], "narrativa": true}}], [{"texto": "Voltare uguale cuore faccia. Accettare comodo caso. Suonare abbastanza tirare inoltre infatti. Rompere secondo moglie conservare preoccupare.", "citacao": {"itens": [{"id": "it027"}], "narrativa": true}}, {"texto": "Silenzio massimo coscienza normale dottore.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}], [{"texto": "Osservare certo vento provvedere avvertire fumare.", "citacao": {"itens": [{"id": "it014"}, {"id": "it011"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Esempio lavorare pomeriggio fronte dovere.", "citacao": null}], [{"texto": "Medico addirittura oggi descrivere peccato carta albergo.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}], [{"texto": "Presso tuttavia lato fabbrica pazzo. Mano grande volta grado motivo visita collina milione.", "citacao": null}], [{"texto": "Frase serio bastare privato aria grande.", "citacao": {"itens": [{"id": "it005"}], "narrativa": false}}, {"texto": "Contatto colpire intorno abitare almeno malattia oppure medio. Polizia peso persona assistere occhio.", "citacao": {"itens": [{"id": "it029"}, {"id": "it005"}], "narrativa": false}}, {"texto": "Prima no muovere sacrificio.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}], [{"texto": "Ora attendere perfino produzione fatto ordinare.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}, {"texto": "Centro stupido privato finché. Esporre causa procedere corso soluzione secondo affare.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Quello dimostrare spiegare annunciare attraversare roba. Vino staccare riunire evitare. Trasformare bosco cuore bocca cui.", "citacao": null}, {"texto": "Tenere unire celebrare unico italiano lotta. Caratteristico caldo riportare piacere grigio economico estremo. Ripetere preciso già qualcuno notte minuto fede accanto.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Sentire eccetera dolce nazionale.", "citacao": {"itens": [{"id": "it017"}], "narrativa": false}}, {"texto": "Pregare come capace scusare utile mangiare mi memoria.", "citacao": {"itens": [{"id": "it028"}], "narrativa": true}}, {"texto": "Gusto indicare accordo bagno congresso speranza. Quasi mandare segnare avvertire entro. Sposare minuto dove pronto confessare musica.", "citacao": {"itens": [{"id": "it014"}], "narrativa": true}}, {"texto": "Temere servizio movimento soluzione girare francese occasione.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}], [{"texto": "Sperare matrimonio lasciare insegnare grave passo bosco. Soffrire teatro disporre distanza insomma. Papà rivolgere funzione bisognare ferro cittadino.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Proprio verità possibilità rendere svegliare comporre. Vestire famiglia divenire perciò.", "citacao": null}], [{"texto": "Destro strumento richiedere. Uscire azzurro essere zona sede.", "citacao": null}, {"texto": "Salutare smettere abitare coloro divenire frase. Abito chiamare esporre industria gesto classe. Dio oggi ciò.", "citacao": {"itens": [{"id": "it031"}], "narrativa": false}}, {"texto": "Ma avere settimana elevare acqua centrale mamma.", "citacao": null}, {"texto": "Condurre grazie guerra maggio caratteristico stazione.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Lasciare abito età soltanto piangere ordinare pericolo.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}]], "direta": {"texto": "Sud spesa rivelare labbro frutto valle spalla civiltà morale campo conto nome", "citacao": {"itens": [{"id": "it023", "locator": "4", "label": "page"}], "narrativa": false}}, "tabela": [["Piangere", "Sala volgere togliere relazione chiedere.", {"itens": [{"id": "it028"}], "narrativa": false}], ["Offendere", "Guardia pericoloso madre.", {"itens": [{"id": "it005"}], "narrativa": false}], ["Strumento", "Interessare perfino povero o perfetto.", {"itens": [{"id": "it007"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it019"}], "narrativa": true}, "injecoes": {"orfas": [], "nao_citadas": [], "ano_trocado": null}}