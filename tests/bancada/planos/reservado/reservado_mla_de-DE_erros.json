ner-title": "Das Gesundheitswesen", "volume": "35", "issue": "11", "page": "412-422"}, {"id": "it022", "type": "book", "title": "Fünf nicht Eis Erde rechnen braun Jahr Weg weit etwas reiten fast schön dafür Hund Bruder", "language": "de_DE", "issued": {"date-parts": [[2011]]}, "author": [{"family": "Pohl", "given": "Svetlana"}], "publisher": "Weinhold Binner AG & Co. OHG", "publisher-place": "Chemnitz"}, {"id": "it023", "type": "article-journal", "title": "Frau Mama zehn nehmen öffnen braun", "language": "de_DE", "issued": {"date-parts": [[2011]]}, "author": [{"family": "Pohl", "given": "Svetlana"}], "container-title": "Revue d'Épidémiologie et de Santé Publique", "volume": "65", "issue": "4", "page": "681-686"}, {"id": "extra0", "type": "article-journal", "title": "Liegen her vorbei Opa braun ohne sprechen Tante", "language": "de_DE", "issued": {"date-parts": [[1994]]}, "author": [{"family": "Weihmann-Weinhage", "given": "Metin"}, {"family": "Häring", "given": "Aleksandra"}], "container-title": "Gaceta Sanitaria", "volume": "23", "issue": "11", "page": "47-65"}, {"id": "extra1", "type": "webpage", "title": "Schüler Hund groß rot Sohn nicht schon", "language": "de_DE", "issued": {"date-parts": [[1991]]}, "author": [{"family": "Roht", "given": "Diethard", "non-dropping-particle": "van der"}, {"family": "Fritsch", "given": "Christin"}, {"family": "Zänker", "given": "Filippo"}, {"family": "Adolph", "given": "Catharina"}], "URL": "https://exemplo-reservado.org/7783", "accessed": {"date-parts": [[2026, 11, 10]]}}], "paragrafos": [[{"texto": "Hat wenig nein sehen weiter. Oft Sohn nämlich deshalb.", "citacao": {"itens": [{"id": "it016"}, {"id": "it006"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Fahrrad tief gern wenn sehen Vater will schlimm.", "citacao": {"itens": [{"id": "it014"}], "narrativa": false}}], [{"texto": "Krank genau mich finden.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Schicken zusammen wenn freuen dem.", "citacao": {"itens": [{"id": "it017"}, {"id": "it011"}, {"id": "it014"}], "narrativa": false}}], [{"texto": "Schauen unser Kind heiß. Fiel reich sagen nun.", "citacao": {"itens": [{"id": "it021"}], "narrativa": false}}], [{"texto": "Lehrer essen Seite. Schaffen durch stark jeder.", "citacao": null}, {"texto": "Neun lassen hin.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}], [{"texto": "Hören fiel fest endlich merken dir Freude.", "citacao": null}, {"texto": "Wirklich hat im Mädchen daran stehen.", "citacao": {"itens": [{"id": "it003"}, {"id": "it013"}], "narrativa": false}}], [{"texto": "Werden kein allein Seite blau schlagen. Ist einfach ab dann.", "citacao": {"itens": [{"id": "it009"}, {"id": "it016"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Schon dazu dauern die Bild.", "citacao": null}], [{"texto": "Mit beißen Fisch lustig.", "citacao": {"itens": [{"id": "it007"}, {"id": "it010"}, {"id": "it022"}], "narrativa": false}}, {"texto": "Zur kein leicht suchen sieben Mutter Hunger Leute.", "citacao": {"itens": [{"id": "it008"}, {"id": "it016"}], "narrativa": false}}, {"texto": "Dabei nie rennen vom denken durch beißen.", "citacao": null}], [{"texto": "Nämlich Wiese Frage dabei Mädchen schwer. Überall vielleicht früher dumm fährt.", "citacao": {"itens": [{"id": "it014"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Glas lustig lassen Tisch kurz wünschen. Neben Musik schwimmen Eis.", "citacao": {"itens": [{"id": "it005"}, {"id": "it000"}, {"id": "it020"}], "narrativa": false}}], [{"texto": "Zum richtig Tür Polizei. Schlimm schwimmen Schiff ihr. Fast kochen nichts gibt heißen.", "citacao": {"itens": [{"id": "it015"}, {"id": "it010"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Arzt sechs vergessen Familie erschrecken Ding.", "citacao": {"itens": [{"id": "it000"}], "narrativa": false}}, {"texto": "Mama Stein bald oft Licht nichts Welt.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Sonst neu Bild langsam müssen Berg. Bin richtig früher Berg setzen.", "citacao": {"itens": [{"id": "it007"}, {"id": "it019"}, {"id": "it009"}], "narrativa": false}}], [{"texto": "Waschen kennen Geburtstag oder lieb Eltern Hund. Geschenk wenn dich ich gern ihr Woche.", "citacao": null}, {"texto": "Auto Angst den. Nase da blau so Tür zur. Neben liegen deshalb oben nah Tisch ganz Gott.", "citacao": {"itens": [{"id": "it020"}, {"id": "it009"}], "narrativa": false}}, {"texto": "Warten nun Gott. Bekommen weiter Tür. Bleiben Auge tot fressen.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Singen sollen anfangen Schuh haben Straße See.", "citacao": {"itens": [{"id": "it001"}], "narrativa": false}}], [{"texto": "Heraus nach tun daran dafür.", "citacao": {"itens": [{"id": "it003"}, {"id": "it006"}], "narrativa": false}}, {"texto": "Erklären Tisch scheinen Schnee Fenster Baum dir Hase.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}, {"texto": "Liegen wünschen fröhlich waschen sie Freund.", "citacao": {"itens": [{"id": "it008"}, {"id": "it003"}], "narrativa": false}}], [{"texto": "Lustig rot schlafen Uhr. Dir den Erde.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}, {"texto": "Gleich fressen Wissen glücklich.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}], [{"texto": "Damit dazu Papa nach in. Bein Winter traurig die Feuer lieb.", "citacao": null}], [{"texto": "Glauben auf Hunger Angst trinken denn um. Tier packen zurück sieht Mensch lange schwarz.", "citacao": {"itens": [{"id": "it018"}, {"id": "it008"}, {"id": "it003"}], "narrativa": false}}, {"texto": "Andere lesen fallen Ferien. Setzen unten werden halbe schwer fragen. Wenn fliegen zwei Sommer tot Lehrer der Tier.", "citacao": {"itens": [{"id": "it007"}, {"id": "it011"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Waschen wichtig rot verlieren für blau.", "citacao": {"itens": [{"id": "it012"}], "narrativa": false}}], [{"texto": "Wünschen bauen noch freuen reiten Wald Meer. Angst sehen weit ab dort zwei.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Suchen grün Welt die freuen können.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}, {"texto": "Ende halbe Mann scheinen nur.", "citacao": {"itens": [{"id": "it010"}, {"id": "it003"}, {"id": "it021"}], "narrativa": false}}]], "direta": {"texto": "Dick Fahrrad damit hier schön ja vorbei Apfel damit darin fressen singen Stein dort", "citacao": {"itens": [{"id": "it001", "locator": "162", "label": "page"}], "narrativa": false}}, "tabela": [["Ihm", "Junge rechnen fünf dauern.", {"itens": [{"id": "it017"}], "narrativa": false}], ["Onkel", "Uns Sommer Geld draußen.", {"itens": [{"id": "it007"}], "narrativa": false}], ["Klein", "Hin schlimm natürlich Straße oben.", {"itens": [{"id": "it015"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it017"}], "narrativa": false}, "injecoes": {"orfas": ["it008", "it021"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}