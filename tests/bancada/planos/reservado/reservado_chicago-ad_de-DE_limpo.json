017"}], "narrativa": true}}], [{"texto": "Lesen endlich Freude der. Schule bleiben Apfel Mama Tisch See.", "citacao": {"itens": [{"id": "it022"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Unter gar dort gelb Bild.", "citacao": {"itens": [{"id": "it003"}], "narrativa": false}}], [{"texto": "Wer alt warten sie sonst wahr weg Arzt. Freuen heraus Zug ich treffen schicken.", "citacao": {"itens": [{"id": "it016"}], "narrativa": false}}, {"texto": "Es kochen lustig dauern ihn. Offen noch Nacht kommen.", "citacao": {"itens": [{"id": "it022"}], "narrativa": true}}], [{"texto": "Woche Licht fiel Arzt. Über bei verstehen Arzt.", "citacao": {"itens": [{"id": "it006"}, {"id": "it024"}, {"id": "it018"}], "narrativa": false}}, {"texto": "Weiter los schlecht Wagen.", "citacao": {"itens": [{"id": "it022"}], "narrativa": true}}, {"texto": "Kaufen nah Stelle Geld davon.", "citacao": {"itens": [{"id": "it025"}], "narrativa": false}}], [{"texto": "Öffnen ob zwei vorbei Vogel. Drehen sich steigen nehmen wollen ihn.", "citacao": null}, {"texto": "Musik Stunde Eis hinein bei mit.", "citacao": {"itens": [{"id": "it013"}, {"id": "it027"}, {"id": "it029"}], "narrativa": false}}, {"texto": "Es da stehen Berg. Bringen acht richtig.", "citacao": null}, {"texto": "Spaß her Schwester die Uhr.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}], [{"texto": "Der klettern Sonne zehn.", "citacao": {"itens": [{"id": "it001"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Geld scheinen blau eigentlich groß bei Arzt.", "citacao": null}, {"texto": "Buch Fenster früh wohnen Wasser.", "citacao": {"itens": [{"id": "it012"}, {"id": "it027"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Verstehen merken Schule wieder las ich.", "citacao": {"itens": [{"id": "it010"}], "narrativa": false}}, {"texto": "Schnee Welt Tier Licht daran frei.", "citacao": {"itens": [{"id": "it023"}], "narrativa": false}}], [{"texto": "Neben baden Loch wahr Stunde nennen.", "citacao": null}], [{"texto": "