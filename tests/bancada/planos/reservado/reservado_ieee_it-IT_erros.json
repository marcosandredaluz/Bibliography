mily": "Branciforte-Modigliani", "given": "Sylvia"}, {"family": "Guarato", "given": "Armando"}, {"family": "Palombi", "given": "Rosario"}], "container-title": "Epidemiologia & Prevenzione", "volume": "16", "issue": "3", "page": "495-500", "DOI": "10.99999/teste.reservado.44461"}, {"id": "extra1", "type": "article-journal", "title": "Pace vendere inutile tirare brutto risultare neanche storico", "language": "it_IT", "issued": {"date-parts": [[2011]]}, "author": [{"family": "Zeffirelli", "given": "Edoardo", "non-dropping-particle": "di"}, {"family": "Novaro", "given": "Ermanno"}, {"family": "Barcella", "given": "Lamberto"}, {"family": "Delle", "given": "Domenico"}], "container-title": "Cadernos de Saúde Pública", "volume": "49", "issue": "7", "page": "875-882", "DOI": "10.99999/teste.reservado.17258"}], "paragrafos": [[{"texto": "Su difficile stesso scegliere.", "citacao": {"itens": [{"id": "it008"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Problema passato senso cantare. Avvocato sotto cultura signora croce assoluto. Momento musica serie resto su pagare. Gridare vivere rapido lira principio.", "citacao": {"itens": [{"id": "it026"}], "narrativa": true}}], [{"texto": "Vuoto rientrare possedere produzione rientrare. Ultimo maggiore oramai procedere. Zio sorridere minuto marito necessità morire.", "citacao": {"itens": [{"id": "it001"}], "narrativa": true}}], [{"texto": "Vivere oramai industria silenzio crisi tempo.", "citacao": {"itens": [{"id": "it019"}], "narrativa": false}}, {"texto": "Ammettere stanza scappare lingua vi.", "citacao": {"itens": [{"id": "it003"}], "narrativa": true}}, {"texto": "Esperienza pace presso. Poiché coloro signore pronto ecco specie nuovo.", "citacao": {"itens": [{"id": "it009"}], "narrativa": false}}], [{"texto": "Cui attendere muovere perfino rientrare sorprendere.", "citacao": {"itens": [{"id": "it021"}, {"id": "it026"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Errore ammettere attendere per limitare decisione medico.", "citacao": {"itens": [{"id": "it026"}, {"id": "it009"}, {"id": "it013"}], "narrativa": false}}], [{"texto": "Nulla mentre repubblica accadere coraggio appunto americano.", "citacao": {"itens": [{"id": "it004"}], "narrativa": false}}, {"texto": "Giungere chissà maggiore uso epoca esistere mangiare.", "citacao": {"itens": [{"id": "it027"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Rapido latino tono triste considerare fra.", "citacao": null}, {"texto": "Peccato naturale gettare inizio zia.", "citacao": {"itens": [{"id": "it018"}], "narrativa": false}}], [{"texto": "Stampa figlio cane avvicinare articolo.", "citacao": {"itens": [{"id": "it020"}], "narrativa": false}}, {"texto": "Arrestare sorridere provare.", "citacao": {"itens": [{"id": "it016"}], "narrativa": true}}], [{"texto": "Pensare dimostrare battaglia destino.", "citacao": {"itens": [{"id": "it000"}, {"id": "it009"}, {"id": "it015"}], "narrativa": false}}, {"texto": "Signore prossimo nome commercio. Vivo accogliere sistema pagare salire. Avanti scrittore nord qualsiasi nessuno ufficio.", "citacao": {"itens": [{"id": "it026"}], "narrativa": false}}, {"texto": "Accompagnare spingere meritare maniera rimettere fondare.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Opinione stanco volta mese scena arma.", "citacao": {"itens": [{"id": "it024"}], "narrativa": false}}], [{"texto": "Continuare lingua conservare fissare preoccupare piangere rapporto.", "citacao": null}, {"texto": "Molto più tanto scena.", "citacao": null}], [{"texto": "Zia meritare capo pane collo unire lungo corso.", "citacao": {"itens": [{"id": "it002"}, {"id": "it009"}, {"id": "it008"}], "narrativa": false}}, {"texto": "Fondo successo assistere lira imporre.", "citacao": {"itens": [{"id": "it023"}], "narrativa": true}}], [{"texto": "Magari povero arte calcio.", "citacao": {"itens": [{"id": "it024"}], "narrativa": true}}, {"texto": "Appunto ridere levare.", "citacao": {"itens": [{"id": "it027"}, {"id": "it021"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Film subito anche vestito pranzo molto. Caldo preciso soltanto pane cane pelle niente.", "citacao": {"itens": [{"id": "it028"}, {"id": "it005"}, {"id": "it021"}], "narrativa": false}}], [{"texto": "Svolgere centrale azione orecchio insieme bagno poesia. Abitare ordine necessario particolare molto appartenere.", "citacao": {"itens": [{"id": "it007"}, {"id": "it028"}, {"id": "it000"}], "narrativa": false}}, {"texto": "Venire arma peso solo rifiutare fantasia. Attento proprio ammazzare grande concetto milione. Necessità chilometro trarre largo raccontare.", "citacao": {"itens": [{"id": "it013"}], "narrativa": false}}], [{"texto": "Spesa loro invece fatica giardino ricchezza albergo. Neanche comporre giovane durare relazione cultura. Guardare ampio nero seguito. Accettare dimenticare stamattina signora mentre segretario scrittore appoggiare.", "citacao": {"itens": [{"id": "it011"}, {"id": "it007"}, {"id": "it014"}], "narrativa": false}}, {"texto": "Anche controllo spingere solo sicurezza morte. Intero corpo esporre moglie. Operazione controllo piangere basso elettrico.", "citacao": {"itens": [{"id": "it008"}, {"id": "it020"}], "narrativa": false}}, {"texto": "Collina latino automobile titolo odore. Passare periodo necessità vista.", "citacao": {"itens": [{"id": "it027"}, {"id": "it009"}, {"id": "it021"}], "narrativa": false}}], [{"texto": "Imporre sorgere come atteggiamento.", "citacao": {"itens": [{"id": "it017"}, {"id": "it023"}], "narrativa": false}}], [{"texto": "Staccare provvedere condurre causa salvare tuo vincere.", "citacao": {"itens": [{"id": "it027"}, {"id": "it013"}], "narrativa": false}}, {"texto": "Sorella piccolo spegnere. Contare ammazzare liberare dichiarare.", "citacao": null}, {"texto": "Chilometro descrivere presso stabilire volto acqua biondo.", "citacao": null}], [{"texto": "Mettere semplice pane marito diritto folla. Pagina là italiano diventare.", "citacao": null}], [{"texto": "Porre offendere fretta lavoro costruire.", "citacao": {"itens": [{"id": "it012"}, {"id": "it019"}], "narrativa": false}}, {"texto": "Opera risultato decisione difficoltà madre compagno sereno. Aumentare speranza valere.", "citacao": {"itens": [{"id": "it014"}, {"id": "it013"}], "narrativa": false}}], [{"texto": "Oppure perfetto risultare medio che tirare forte.", "citacao": {"itens": [{"id": "it016"}, {"id": "it014"}, {"id": "it010"}], "narrativa": false}}, {"texto": "Circa estremo questione greco circa simile. Porre scala mestiere soffrire quindi significare.", "citacao": {"itens": [{"id": "it002"}], "narrativa": false}}, {"texto": "Stato comporre più paura morire.", "citacao": {"itens": [{"id": "it022"}], "narrativa": false}}], [{"texto": "Ridurre discorso basso calcio. Voi stringere accogliere concetto. Tardi dedicare atteggiamento volta presente bisogno presenza elemento.", "citacao": {"itens": [{"id": "it006"}], "narrativa": false}}], [{"texto": "Frutto ascoltare pregare riprendere civiltà stupido quindi sotto. Preciso qualche questo pregare fratello invitare. Scoppiare conoscere voglia famoso.", "citacao": {"itens": [{"id": "it004"}, {"id": "it023"}, {"id": "it025"}], "narrativa": false}}, {"texto": "Vincere tirare controllo facile.", "citacao": {"itens": [{"id": "it011"}], "narrativa": false}}, {"texto": "Andare articolo finire finalmente sistema. Breve affare vestito don rispondere.", "citacao": {"itens": [{"id": "it007"}], "narrativa": false}}]], "direta": {"texto": "Sostenere arrestare anima bianco domenica enorme giorno conseguenza inglese diritto risposta attento vento freddo", "citacao": {"itens": [{"id": "it016", "locator": "215", "label": "page"}], "narrativa": false}}, "tabela": [["Prevedere", "Figurare trovare leggere civiltà.", {"itens": [{"id": "it008"}], "narrativa": false}], ["Gridare", "Lasciare autorità peccato evitare certamente.", {"itens": [{"id": "it027"}], "narrativa": false}], ["Godere", "Sognare riempire colpo stagione neppure direttore lui materia.", {"itens": [{"id": "it025"}], "narrativa": false}]], "base_fonte": {"itens": [{"id": "it027"}], "narrativa": true}, "injecoes": {"orfas": ["it026", "it019"], "nao_citadas": ["extra0", "extra1"], "ano_trocado": null}}